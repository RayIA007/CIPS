# =============================================================================
# YAML LOADER
# =============================================================================

class SafeYaml:

    @staticmethod
    def load(path: Path) -> Dict[str, Any]:

        with path.open(
            "r",
            encoding="utf-8"
        ) as stream:

            return yaml.safe_load(stream)

    @staticmethod
    def save(
        path: Path,
        data: Dict[str, Any]
    ) -> None:

        temporary = tempfile.NamedTemporaryFile(
            delete=False,
            suffix=".yaml",
            dir=str(path.parent)
        )

        try:

            with open(
                temporary.name,
                "w",
                encoding="utf-8"
            ) as stream:

                yaml.safe_dump(
                    data,
                    stream,
                    allow_unicode=True,
                    sort_keys=False,
                    indent=2
                )

            shutil.move(
                temporary.name,
                path
            )

        finally:

            if Path(
                temporary.name
            ).exists():

                Path(
                    temporary.name
                ).unlink(missing_ok=True)


