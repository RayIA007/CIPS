ACCEPTED_STATES = {
    "ACCEPTED",
    "COMPLETED",
    "CERTIFIED",
    "RELEASED",
}

ACTIVE_STATES = {
    "IN_PROGRESS",
    "IMPLEMENTED",
    "VALIDATING",
    "TESTED",
    "READY_FOR_REVIEW",
    "UNDER_REVIEW",
}

