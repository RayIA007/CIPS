def resolve_absolute_path(
    path: Path,
    *,
    base_directory: Path | None = None,
) -> Path:
    """Resolve a user-supplied path into a canonical absolute path."""

    candidate = path.expanduser()

    if not candidate.is_absolute():
        base = (
            base_directory
            if base_directory is not None
            else Path.cwd()
        )
        candidate = base / candidate

    return candidate.resolve()


def build_validator_config(
    arguments: argparse.Namespace,
) -> ValidatorConfig:
    """Build and validate runtime configuration from CLI arguments."""

    if arguments.project_root is None:
        project_root = PROJECT_ROOT.resolve()
    else:
        project_root = resolve_absolute_path(
            arguments.project_root
        )

    if arguments.production_system_root is None:
        production_system_root = (
            project_root / "12_PRODUCTION_SYSTEM"
        ).resolve()
    else:
        production_system_root = resolve_absolute_path(
            arguments.production_system_root,
            base_directory=project_root,
        )

    if arguments.architecture_directory is None:
        architecture_directory = (
            production_system_root
            / ARCHITECTURE_DIRECTORY_NAME
        ).resolve()
    else:
        architecture_directory = resolve_absolute_path(
            arguments.architecture_directory,
            base_directory=project_root,
        )

    if arguments.project_control_directory is None:
        project_control_directory = (
            production_system_root
            / PROJECT_CONTROL_DIRECTORY_NAME
        ).resolve()
    else:
        project_control_directory = resolve_absolute_path(
            arguments.project_control_directory,
            base_directory=project_root,
        )

    if arguments.scripts_directory is None:
        scripts_directory = (
            project_root / "08_SCRIPTS"
        ).resolve()
    else:
        scripts_directory = resolve_absolute_path(
            arguments.scripts_directory,
            base_directory=project_root,
        )

    report_path: Path | None = None

    if arguments.report is not None:
        report_path = resolve_absolute_path(
            arguments.report,
            base_directory=project_root,
        )

    config = ValidatorConfig(
        project_root=project_root,
        production_system_root=production_system_root,
        architecture_directory=architecture_directory,
        project_control_directory=project_control_directory,
        scripts_directory=scripts_directory,
        strict=bool(arguments.strict),
        fail_fast=bool(arguments.fail_fast),
        verbose=bool(arguments.verbose),
        output_format=str(arguments.output_format),
        report_path=report_path,
    )

    config.validate()
    validate_configuration_boundaries(config)

    return config


def validate_configuration_boundaries(
    config: ValidatorConfig,
) -> None:
    """Ensure configured repository paths remain within the project root."""

    controlled_paths: tuple[tuple[str, Path], ...] = (
        (
            "production_system_root",
            config.production_system_root,
        ),
        (
            "architecture_directory",
            config.architecture_directory,
        ),
        (
            "project_control_directory",
            config.project_control_directory,
        ),
        (
            "scripts_directory",
            config.scripts_directory,
        ),
    )

    for path_name, path_value in controlled_paths:
        if not is_relative_to(
            path_value,
            config.project_root,
        ):
            raise ConfigurationError(
                f"Configured path {path_name!r} escapes the "
                f"project root: {path_value}"
            )

    if not is_relative_to(
        config.architecture_directory,
        config.production_system_root,
    ):
        raise ConfigurationError(
            "Architecture directory must exist inside the "
            "Production System root."
        )

    if not is_relative_to(
        config.project_control_directory,
        config.production_system_root,
    ):
        raise ConfigurationError(
            "Project Control directory must exist inside the "
            "Production System root."
        )

    if not is_relative_to(
        config.scripts_directory,
        config.project_root,
    ):
        raise ConfigurationError(
            "Scripts directory must exist inside the project root."
        )

    if (
        config.report_path is not None
        and config.report_path.exists()
        and config.report_path.is_dir()
    ):
        raise ConfigurationError(
            "Configured report destination is a directory."
        )


