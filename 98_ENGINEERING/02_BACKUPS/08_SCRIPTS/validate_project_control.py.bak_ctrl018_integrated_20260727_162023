def validate_repository(
    context: ValidationContext,
) -> StageResult:
    """Validate repository structure and required files."""

    result = StageResult(stage=StageName.REPOSITORY)
    config = context.config

    required_directories: tuple[tuple[str, Path], ...] = (
        ("project_root", config.project_root),
        ("production_system_root", config.production_system_root),
        ("architecture_directory", config.architecture_directory),
        ("project_control_directory", config.project_control_directory),
        ("scripts_directory", config.scripts_directory),
    )

    for directory_name, directory_path in required_directories:
        result.checks_executed += 1

        if not directory_path.exists():
            result.add_finding(
                critical_finding(
                    code="PCV-REP-DIRECTORY-MISSING",
                    message=(
                        f"Required directory {directory_name!r} "
                        "does not exist."
                    ),
                    stage=StageName.REPOSITORY,
                    source=directory_path,
                    remediation=(
                        "Restore or create the directory at the "
                        "architecture-approved location."
                    ),
                )
            )
            continue

        if not directory_path.is_dir():
            result.add_finding(
                critical_finding(
                    code="PCV-REP-DIRECTORY-INVALID",
                    message=(
                        f"Required repository location "
                        f"{directory_name!r} is not a directory."
                    ),
                    stage=StageName.REPOSITORY,
                    source=directory_path,
                    remediation=(
                        "Replace the invalid object with the required "
                        "repository directory."
                    ),
                )
            )
            continue

        result.add_finding(
            info_finding(
                code="PCV-REP-DIRECTORY-VALID",
                message=(
                    f"Required directory {directory_name!r} is present."
                ),
                stage=StageName.REPOSITORY,
                source=directory_path,
            )
        )

    result.checks_executed += 1

    if not is_relative_to(
        config.production_system_root,
        config.project_root,
    ):
        result.add_finding(
            critical_finding(
                code="PCV-REP-PRODUCTION-ROOT-ESCAPE",
                message=(
                    "Production System root is outside the configured "
                    "project root."
                ),
                stage=StageName.REPOSITORY,
                source=config.production_system_root,
                remediation=(
                    "Run the validator from the approved "
                    "12_PRODUCTION_SYSTEM/08_SCRIPTS location."
                ),
            )
        )

    result.checks_executed += 1

    if SCRIPT_PATH.parent.resolve() != config.scripts_directory.resolve():
        result.add_finding(
            error_finding(
                code="PCV-REP-SCRIPT-LOCATION",
                message=(
                    "Validator script is not running from the configured "
                    "scripts directory."
                ),
                stage=StageName.REPOSITORY,
                source=SCRIPT_PATH,
                remediation=(
                    "Place validate_project_control.py in "
                    "08_SCRIPTS."
                ),
            )
        )

    for filename in CONSTITUTIONAL_FILES:
        path = context.resolve_architecture_file(filename)
        result.checks_executed += 1

        if not path.is_file():
            result.add_finding(
                critical_finding(
                    code="PCV-REP-CONSTITUTION-MISSING",
                    message=(
                        f"Constitutional document {filename!r} "
                        "is missing."
                    ),
                    stage=StageName.REPOSITORY,
                    source=path,
                    remediation=(
                        "Restore the document from the last valid "
                        "certified source."
                    ),
                )
            )
            continue

        if path.stat().st_size == 0:
            result.add_finding(
                critical_finding(
                    code="PCV-REP-CONSTITUTION-EMPTY",
                    message=(
                        f"Constitutional document {filename!r} is empty."
                    ),
                    stage=StageName.REPOSITORY,
                    source=path,
                    remediation=(
                        "Restore the complete approved constitutional "
                        "document."
                    ),
                )
            )
            continue

        result.add_finding(
            info_finding(
                code="PCV-REP-CONSTITUTION-PRESENT",
                message=(
                    f"Constitutional document {filename!r} is present."
                ),
                stage=StageName.REPOSITORY,
                source=path,
            )
        )

    for filename in PROJECT_CONTROL_FILES:
        path = context.resolve_project_control_file(filename)
        result.checks_executed += 1

        if not path.is_file():
            result.add_finding(
                error_finding(
                    code="PCV-REP-CONTROL-FILE-MISSING",
                    message=(
                        f"Project Control file {filename!r} is missing."
                    ),
                    stage=StageName.REPOSITORY,
                    source=path,
                    remediation=(
                        "Create or restore the file according to the "
                        "Phase 0 Roadmap."
                    ),
                )
            )
            continue

        if path.stat().st_size == 0:
            result.add_finding(
                error_finding(
                    code="PCV-REP-CONTROL-FILE-EMPTY",
                    message=(
                        f"Project Control file {filename!r} is empty."
                    ),
                    stage=StageName.REPOSITORY,
                    source=path,
                    remediation=(
                        "Restore the complete Project Control content."
                    ),
                )
            )
            continue

        result.add_finding(
            info_finding(
                code="PCV-REP-CONTROL-FILE-PRESENT",
                message=(
                    f"Project Control file {filename!r} is present."
                ),
                stage=StageName.REPOSITORY,
                source=path,
            )
        )

    result.checks_executed += 1

    if not SCRIPT_PATH.is_file():
        result.add_finding(
            critical_finding(
                code="PCV-REP-VALIDATOR-MISSING",
                message="The validator script cannot locate itself.",
                stage=StageName.REPOSITORY,
                source=SCRIPT_PATH,
            )
        )
    else:
        result.add_finding(
            info_finding(
                code="PCV-REP-VALIDATOR-PRESENT",
                message="Validator script location is accessible.",
                stage=StageName.REPOSITORY,
                source=SCRIPT_PATH,
            )
        )

    context.metadata["repository_validated"] = result.passed
    context.metadata["repository_root"] = str(
        config.project_root.resolve()
    )

    return result


