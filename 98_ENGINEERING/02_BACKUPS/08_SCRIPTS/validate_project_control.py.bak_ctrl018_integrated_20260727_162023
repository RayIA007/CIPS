def validate_contracts(
    context: ValidationContext,
) -> StageResult:
    """Validate document loading and structural contracts."""

    result = StageResult(stage=StageName.CONTRACTS)

    for filename in REQUIRED_YAML_FILES:
        path = context.resolve_project_control_file(filename)
        result.checks_executed += 1

        if not path.is_file():
            result.add_finding(
                error_finding(
                    code="PCV-CON-YAML-MISSING",
                    message=f"Required YAML document {filename!r} is missing.",
                    stage=StageName.CONTRACTS,
                    source=path,
                    remediation=(
                        "Restore the required YAML document before "
                        "running Project Control certification."
                    ),
                )
            )
            continue

        try:
            document = load_document(context, path)
        except ProjectControlValidatorError as exc:
            result.add_finding(
                critical_finding(
                    code="PCV-CON-YAML-LOAD-FAILED",
                    message=str(exc),
                    stage=StageName.CONTRACTS,
                    source=path,
                    remediation=(
                        "Correct YAML syntax, duplicate keys or encoding "
                        "and rerun validation."
                    ),
                )
            )
            continue

        if not isinstance(document, Mapping):
            result.add_finding(
                error_finding(
                    code="PCV-CON-YAML-ROOT-TYPE",
                    message=(
                        f"YAML document {filename!r} must have a mapping "
                        "at its root."
                    ),
                    stage=StageName.CONTRACTS,
                    source=path,
                    remediation=(
                        "Replace the root sequence or scalar with the "
                        "official top-level mapping structure."
                    ),
                )
            )
            continue

        if not document:
            result.add_finding(
                error_finding(
                    code="PCV-CON-YAML-EMPTY",
                    message=f"YAML document {filename!r} is empty.",
                    stage=StageName.CONTRACTS,
                    source=path,
                )
            )
            continue

        result.add_finding(
            info_finding(
                code="PCV-CON-YAML-VALID",
                message=(
                    f"YAML document {filename!r} loaded successfully "
                    "without duplicate keys."
                ),
                stage=StageName.CONTRACTS,
                source=path,
            )
        )

    markdown_files = tuple(
        filename
        for filename in PROJECT_CONTROL_FILES
        if Path(filename).suffix.lower() == ".md"
    )

    for filename in markdown_files:
        path = context.resolve_project_control_file(filename)
        result.checks_executed += 1

        if not path.is_file():
            continue

        try:
            content = load_document(context, path)
        except ProjectControlValidatorError as exc:
            result.add_finding(
                error_finding(
                    code="PCV-CON-MARKDOWN-LOAD-FAILED",
                    message=str(exc),
                    stage=StageName.CONTRACTS,
                    source=path,
                )
            )
            continue

        if not isinstance(content, str) or not content.strip():
            result.add_finding(
                error_finding(
                    code="PCV-CON-MARKDOWN-EMPTY",
                    message=f"Markdown document {filename!r} has no content.",
                    stage=StageName.CONTRACTS,
                    source=path,
                )
            )
            continue

        heading_count = sum(
            1
            for line in content.splitlines()
            if line.lstrip().startswith("#")
        )

        if heading_count == 0:
            result.add_finding(
                warning_finding(
                    code="PCV-CON-MARKDOWN-NO-HEADINGS",
                    message=(
                        f"Markdown document {filename!r} contains no "
                        "recognized headings."
                    ),
                    stage=StageName.CONTRACTS,
                    source=path,
                    remediation=(
                        "Confirm that the file follows the official "
                        "structured Markdown format."
                    ),
                )
            )
        else:
            result.add_finding(
                info_finding(
                    code="PCV-CON-MARKDOWN-STRUCTURED",
                    message=(
                        f"Markdown document {filename!r} contains "
                        f"{heading_count} heading lines."
                    ),
                    stage=StageName.CONTRACTS,
                    source=path,
                )
            )

    required_top_level_contracts: dict[str, tuple[str, ...]] = {
        "CIPS_CURRENT_STATE.yaml": (
            "document",
            "project",
            "execution",
        ),
        "CIPS_DEPENDENCY_MAP.yaml": (
            "document",
            "project",
            "dependency_model",
        ),
        "CIPS_FILE_MANIFEST.yaml": (
            "document",
            "project",
            "registration_model",
        ),
        "CIPS_BASELINE_MANIFEST.yaml": (
            "document",
            "project",
            "baseline_model",
        ),
        "CIPS_PROTECTED_FILES.yaml": (
            "document",
            "project",
            "protection_levels",
        ),
    }

    for filename, required_keys in required_top_level_contracts.items():
        path = context.resolve_project_control_file(filename)
        document = context.get_document(path)

        if not isinstance(document, Mapping):
            continue

        result.checks_executed += len(required_keys)
        result.add_findings(
            validate_mapping_keys(
                data=document,
                required_keys=required_keys,
                stage=StageName.CONTRACTS,
                source=path,
                code_prefix="PCV-CON",
            )
        )

    context.metadata["contracts_validated"] = result.passed

    return result


