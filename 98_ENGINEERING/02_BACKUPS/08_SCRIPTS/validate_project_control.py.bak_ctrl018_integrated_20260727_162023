class StatusResolver:
    """
    Single authority for StageResult and ValidationReport status.

    No caller should infer PASS or FAIL independently from cached flags.
    """

    @staticmethod
    def resolve_findings(
        findings: Iterable[ValidationFinding],
    ) -> ValidationStatus:
        normalized = tuple(findings)

        if any(
            finding.severity is ValidationSeverity.CRITICAL
            for finding in normalized
        ):
            return ValidationStatus.FAIL

        if any(
            finding.severity is ValidationSeverity.ERROR
            for finding in normalized
        ):
            return ValidationStatus.FAIL

        if any(
            finding.severity is ValidationSeverity.WARNING
            for finding in normalized
        ):
            return ValidationStatus.WARNING

        return ValidationStatus.PASS

    @classmethod
    def resolve_stage(
        cls,
        stage_result: StageResult,
    ) -> ValidationStatus:
        return cls.resolve_findings(
            stage_result.findings
        )

    @staticmethod
    def resolve_report(
        stages: Iterable[
            StageResult | NormalizedStageSnapshot
        ],
    ) -> ValidationStatus:
        normalized_stages = tuple(stages)

        if not normalized_stages:
            return ValidationStatus.SKIPPED

        statuses = tuple(
            (
                stage.status
                if isinstance(
                    stage,
                    NormalizedStageSnapshot,
                )
                else StatusResolver.resolve_stage(stage)
            )
            for stage in normalized_stages
        )

        if any(
            status is ValidationStatus.FAIL
            for status in statuses
        ):
            return ValidationStatus.FAIL

        if any(
            status is ValidationStatus.WARNING
            for status in statuses
        ):
            return ValidationStatus.WARNING

        if all(
            status is ValidationStatus.SKIPPED
            for status in statuses
        ):
            return ValidationStatus.SKIPPED

        return ValidationStatus.PASS

    @classmethod
    def synchronize_stage_status(
        cls,
        stage_result: StageResult,
    ) -> ValidationStatus:
        """
        Recalculate and write the canonical status into StageResult.

        This compatibility method is temporary. Part II will replace
        mutable status management with a stricter StageResult contract.
        """

        resolved = cls.resolve_stage(
            stage_result
        )
        stage_result.status = resolved
        return resolved


class ResultNormalizer:
    """
    Central authority for finding normalization.

    Rules are deterministic:
        - ordered by priority and rule_id;
        - first applicable non-KEEP decision wins;
        - every removal/replacement is audited;
        - stage status is recalculated after normalization.
    """

    def __init__(
        self,
        rules: Iterable[FindingNormalizationRule] = (),
    ) -> None:
        self._rules = tuple(
            sorted(
                rules,
                key=lambda rule: (
                    rule.priority,
                    rule.rule_id,
                ),
            )
        )

        rule_ids = [
            rule.rule_id
            for rule in self._rules
        ]

        if len(rule_ids) != len(set(rule_ids)):
            raise ValueError(
                "ResultNormalizer rule identifiers must be unique."
            )

    @property
    def rules(self) -> tuple[FindingNormalizationRule, ...]:
        return self._rules

    def normalize_stage(
        self,
        *,
        stage_result: StageResult,
        validation_context: ValidationContext,
    ) -> NormalizedStageSnapshot:
        context = ResultNormalizationContext.from_stage(
            validation_context=validation_context,
            stage_result=stage_result,
        )

        normalized_findings: list[ValidationFinding] = []
        audit: list[NormalizationAuditRecord] = []

        for finding in context.original_findings:
            normalized, audit_record = self._normalize_finding(
                finding=finding,
                context=context,
            )

            if audit_record is not None:
                audit.append(audit_record)

            if normalized is not None:
                normalized_findings.append(normalized)

        canonical_status = StatusResolver.resolve_findings(
            normalized_findings
        )

        return NormalizedStageSnapshot(
            stage=stage_result.stage,
            findings=tuple(normalized_findings),
            checks_executed=stage_result.checks_executed,
            started_at=stage_result.started_at,
            finished_at=stage_result.finished_at,
            duration_seconds=stage_result.duration_seconds,
            status=canonical_status,
            audit=tuple(audit),
        )

    def apply_to_stage(
        self,
        *,
        stage_result: StageResult,
        validation_context: ValidationContext,
    ) -> NormalizedStageSnapshot:
        """
        Normalize findings and synchronize the legacy StageResult object.

        This method is the Part I compatibility bridge. Later parts will
        make NormalizedStageSnapshot the pipeline's direct return type.
        """

        snapshot = self.normalize_stage(
            stage_result=stage_result,
            validation_context=validation_context,
        )

        stage_result.findings[:] = list(
            snapshot.findings
        )
        stage_result.status = snapshot.status

        return snapshot

    def normalize_stages(
        self,
        *,
        stage_results: Iterable[StageResult],
        validation_context: ValidationContext,
    ) -> tuple[NormalizedStageSnapshot, ...]:
        return tuple(
            self.apply_to_stage(
                stage_result=stage_result,
                validation_context=validation_context,
            )
            for stage_result in stage_results
        )

    def _normalize_finding(
        self,
        *,
        finding: ValidationFinding,
        context: ResultNormalizationContext,
    ) -> tuple[
        ValidationFinding | None,
        NormalizationAuditRecord | None,
    ]:
        for rule in self._rules:
            if not rule.applies_to(
                finding=finding,
                context=context,
            ):
                continue

            decision = rule.decision_factory(
                finding,
                context,
            )

            if decision.disposition is FindingDisposition.KEEP:
                continue

            audit = NormalizationAuditRecord(
                rule_id=rule.rule_id,
                stage=context.stage,
                finding_code=finding.code,
                disposition=decision.disposition,
                reason=decision.reason,
            )

            if decision.disposition is FindingDisposition.REMOVE:
                return None, audit

            if decision.disposition is FindingDisposition.REPLACE:
                return decision.replacement, audit

            raise ValidationExecutionError(
                "Unsupported finding normalization disposition: "
                f"{decision.disposition!r}."
            )

        return finding, None


class ExitCodeResolver:
    """
    Single authority for process exit-code resolution.
    """

    @staticmethod
    def resolve(
        *,
        status: ValidationStatus,
        strict: bool,
        critical_errors: int = 0,
    ) -> ExitCode:
        if critical_errors > 0:
            return ExitCode.VALIDATION_FAILURE

        if status is ValidationStatus.FAIL:
            return ExitCode.VALIDATION_FAILURE

        if (
            status is ValidationStatus.WARNING
            and strict
        ):
            return ExitCode.VALIDATION_WARNING

        return ExitCode.SUCCESS

    @classmethod
    def resolve_report(
        cls,
        *,
        report: ValidationReport,
        strict: bool,
    ) -> ExitCode:
        canonical_status = StatusResolver.resolve_report(
            report.stages
        )

        return cls.resolve(
            status=canonical_status,
            strict=strict,
            critical_errors=report.critical_errors,
        )


