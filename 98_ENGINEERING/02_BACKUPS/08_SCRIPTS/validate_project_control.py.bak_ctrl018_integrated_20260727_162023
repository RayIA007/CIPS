def format_finding_line(
    finding: ValidationFinding,
) -> str:
    """Format one finding for human-readable output."""

    source_text = (
        f" [{finding.source}]"
        if finding.source
        else ""
    )

    return (
        f"[{finding.severity.value:<8}] "
        f"{finding.code}: "
        f"{finding.message}"
        f"{source_text}"
    )


def render_text_report(
    report: ValidationReport,
    *,
    verbose: bool = False,
) -> str:
    """Render the complete validation report as plain text."""

    separator = "=" * 72
    lines: list[str] = [
        separator,
        VALIDATOR_NAME,
        separator,
        f"Validator version : {report.validator_version}",
        f"Deliverable       : {report.deliverable_id}",
        f"Project           : {report.project_name}",
        f"Project root      : {report.project_root}",
        "",
    ]

    for stage in report.stages:
        lines.extend(
            [
                f"[{stage.stage.value.upper()}]",
                "-" * 72,
                f"Status            : {stage.status.value}",
                f"Checks executed   : {stage.checks_executed}",
                f"Critical errors   : {stage.critical_errors}",
                f"Errors            : {stage.errors}",
                f"Warnings          : {stage.warnings}",
                f"Duration          : "
                f"{stage.duration_seconds:.6f} seconds",
            ]
        )

        visible_findings = [
            finding
            for finding in stage.findings
            if (
                verbose
                or finding.severity
                is not ValidationSeverity.INFO
            )
        ]

        if visible_findings:
            lines.append("")

            for finding in visible_findings:
                lines.append(
                    format_finding_line(finding)
                )

                if (
                    verbose
                    and finding.remediation
                ):
                    lines.append(
                        f"           Remediation: "
                        f"{finding.remediation}"
                    )

        lines.append("")

    lines.extend(
        [
            separator,
            "FINAL RESULT",
            separator,
            f"Status            : {report.status.value}",
            f"Checks executed   : {report.checks_executed}",
            f"Critical errors   : {report.critical_errors}",
            f"Errors            : {report.errors}",
            f"Warnings          : {report.warnings}",
            f"Duration          : "
            f"{report.duration_seconds:.6f} seconds",
            separator,
        ]
    )

    return "\n".join(lines)


def render_json_report(
    report: ValidationReport,
) -> str:
    """Render the validation report as formatted JSON."""

    return json.dumps(
        report.to_dict(),
        ensure_ascii=False,
        indent=2,
        sort_keys=False,
    )


def render_report(
    report: ValidationReport,
    *,
    output_format: str,
    verbose: bool,
) -> str:
    """Render a report using the requested output format."""

    if output_format == "json":
        return render_json_report(report)

    return render_text_report(
        report,
        verbose=verbose,
    )


def write_report_file(
    *,
    report_path: Path,
    content: str,
) -> None:
    """Write a report without modifying Project Control source files."""

    try:
        report_path.parent.mkdir(
            parents=True,
            exist_ok=True,
        )
        report_path.write_text(
            content,
            encoding=DEFAULT_ENCODING,
        )
    except OSError as exc:
        raise ConfigurationError(
            f"Unable to write report file {report_path}: {exc}"
        ) from exc


