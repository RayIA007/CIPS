def execute_validation(
    config: ValidatorConfig,
) -> ValidationReport:
    """Create the shared context and execute the official pipeline."""

    context = ValidationContext(
        config=config,
        metadata={
            "validator_name": VALIDATOR_NAME,
            "validator_version": VALIDATOR_VERSION,
            "deliverable_id": DELIVERABLE_ID,
            "project_name": PROJECT_NAME,
            "target_project_version": TARGET_PROJECT_VERSION,
            "project_control_version": PROJECT_CONTROL_VERSION,
            "read_only": True,
        },
    )

    pipeline = ValidationPipeline(
        context=context,
        stages=build_pipeline_stages(),
    )

    return pipeline.run()


def emit_report(
    *,
    report: ValidationReport,
    config: ValidatorConfig,
    quiet: bool,
) -> str:
    """Render, optionally print and optionally persist a report."""

    rendered = render_report(
        report,
        output_format=config.output_format,
        verbose=config.verbose,
    )

    if not quiet:
        print(rendered)

    if config.report_path is not None:
        write_report_file(
            report_path=config.report_path,
            content=rendered,
        )

        if (
            not quiet
            and config.output_format == "text"
        ):
            print()
            print(
                "Report written to: "
                f"{config.report_path}"
            )

    return rendered


# =============================================================================
# CONTROLLED ERROR REPORTING
# =============================================================================

def render_configuration_error(
    error: Exception,
) -> str:
    """Render a controlled startup or configuration error."""

    separator = "=" * 72

    return "\n".join(
        (
            separator,
            VALIDATOR_NAME,
            separator,
            "Status            : CONFIGURATION ERROR",
            f"Error type        : {type(error).__name__}",
            f"Message           : {error}",
            separator,
        )
    )


def render_internal_error(
    error: Exception,
) -> str:
    """Render an unexpected validator failure without exposing a traceback."""

    separator = "=" * 72

    return "\n".join(
        (
            separator,
            VALIDATOR_NAME,
            separator,
            "Status            : INTERNAL ERROR",
            f"Error type        : {type(error).__name__}",
            f"Message           : {error}",
            "",
            "The validator did not modify repository files.",
            "Preserve the current repository state and inspect the failure.",
            separator,
        )
    )


# =============================================================================
# MAIN ENTRY POINT
# =============================================================================

def main(
    argv: Sequence[str] | None = None,
) -> int:
    """Run the CIPS Project Control Validator."""

    parser = build_argument_parser()

    try:
        arguments = parser.parse_args(argv)
        config = build_validator_config(arguments)

        if (
            not arguments.quiet
            and config.output_format == "text"
        ):
            print(render_startup_banner(config))
            print()

        report = execute_validation(config)

        emit_report(
            report=report,
            config=config,
            quiet=bool(arguments.quiet),
        )

        exit_code = resolve_exit_code(
            report,
            strict=config.strict,
        )

        return int(exit_code)

    except ConfigurationError as exc:
        print(
            render_configuration_error(exc),
            file=sys.stderr,
        )
        return int(ExitCode.CONFIGURATION_ERROR)

    except KeyboardInterrupt:
        print(
            "\nValidation interrupted by the user.",
            file=sys.stderr,
        )
        return int(ExitCode.INTERNAL_ERROR)

    except Exception as exc:
        print(
            render_internal_error(exc),
            file=sys.stderr,
        )
        return int(ExitCode.INTERNAL_ERROR)


