def extract_current_execution_state(
    current_state: Mapping[str, Any],
) -> dict[str, str]:
    """Extract normalized execution identifiers from Current State."""

    current_phase = nested_get(
        current_state,
        ("execution", "current_phase", "id"),
    )
    current_deliverable = nested_get(
        current_state,
        ("execution", "current_deliverable", "id"),
    )
    current_deliverable_status = nested_get(
        current_state,
        ("execution", "current_deliverable", "status"),
    )
    last_accepted = nested_get(
        current_state,
        ("execution", "last_accepted", "id"),
    )
    next_deliverable = nested_get(
        current_state,
        ("execution", "next_deliverable", "id"),
    )

    return {
        "current_phase": (
            f"PHASE-{current_phase}"
            if str(current_phase).strip().isdigit()
            else str(current_phase or "").strip()
        ),
        "current_deliverable": str(
            current_deliverable or ""
        ).strip(),
        "current_deliverable_status": normalize_state(
            current_deliverable_status or ""
        ),
        "last_accepted": str(
            last_accepted or ""
        ).strip(),
        "next_deliverable": str(
            next_deliverable or ""
        ).strip(),
    }


def extract_dependency_execution_state(
    dependency_map: Mapping[str, Any],
) -> dict[str, str]:
    """Extract normalized execution identifiers from Dependency Map."""

    current_graph_state = dependency_map.get(
        "current_graph_state",
        {},
    )

    if not isinstance(current_graph_state, Mapping):
        return {
            "current_phase": "",
            "current_deliverable": "",
            "last_accepted": "",
            "next_deliverable": "",
        }

    return {
        "current_phase": str(
            current_graph_state.get("current_phase", "")
        ).strip(),
        "current_deliverable": str(
            current_graph_state.get(
                "current_deliverable",
                "",
            )
        ).strip(),
        "last_accepted": str(
            current_graph_state.get(
                "last_accepted_deliverable",
                "",
            )
        ).strip(),
        "next_deliverable": str(
            current_graph_state.get(
                "next_deliverable",
                "",
            )
        ).strip(),
    }


def extract_manifest_deliverable_statuses(
    manifest_entries: Mapping[str, Mapping[str, Any]],
) -> dict[str, str]:
    """Map deliverable identifiers to normalized manifest statuses."""

    statuses: dict[str, str] = {}

    for record in manifest_entries.values():
        deliverable_id = str(
            record.get("deliverable_id", "")
        ).strip()

        if not deliverable_id:
            continue

        statuses[deliverable_id] = normalize_state(
            record.get("status", "")
        )

    return statuses


def validate_identifier_sequence(
    *,
    current_id: str,
    previous_id: str,
    next_id: str,
    ordered_ids: Sequence[str],
    source: Path,
) -> list[ValidationFinding]:
    """Validate previous/current/next identifiers against an order."""

    findings: list[ValidationFinding] = []

    if not ordered_ids or current_id not in ordered_ids:
        return findings

    current_index = ordered_ids.index(current_id)

    if previous_id:
        if previous_id not in ordered_ids:
            findings.append(
                error_finding(
                    code="PCV-CTL-PREVIOUS-NOT-ORDERED",
                    message=(
                        f"Last accepted deliverable {previous_id!r} "
                        "does not exist in the dependency order."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=source,
                )
            )
        elif ordered_ids.index(previous_id) >= current_index:
            findings.append(
                error_finding(
                    code="PCV-CTL-PREVIOUS-ORDER",
                    message=(
                        f"Last accepted deliverable {previous_id!r} "
                        f"does not precede current deliverable "
                        f"{current_id!r}."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=source,
                )
            )

    if next_id:
        if next_id not in ordered_ids:
            findings.append(
                error_finding(
                    code="PCV-CTL-NEXT-NOT-ORDERED",
                    message=(
                        f"Next deliverable {next_id!r} does not exist "
                        "in the dependency order."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=source,
                )
            )
        elif ordered_ids.index(next_id) <= current_index:
            findings.append(
                error_finding(
                    code="PCV-CTL-NEXT-ORDER",
                    message=(
                        f"Next deliverable {next_id!r} does not follow "
                        f"current deliverable {current_id!r}."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=source,
                )
            )

    return findings


def validate_markdown_identity(
    *,
    content: str,
    filename: str,
    deliverable_id: str,
    source: Path,
) -> list[ValidationFinding]:
    """Validate that a control document identifies itself and its deliverable."""

    findings: list[ValidationFinding] = []
    normalized_content = content.upper()

    if filename.upper() not in normalized_content:
        findings.append(
            warning_finding(
                code="PCV-CTL-DOCUMENT-NAME-NOT-FOUND",
                message=(
                    f"Document content does not explicitly identify "
                    f"filename {filename!r}."
                ),
                stage=StageName.PROJECT_CONTROL,
                source=source,
                remediation=(
                    "Add the official filename to the document header "
                    "or status section."
                ),
            )
        )

    if (
        deliverable_id
        and deliverable_id.upper() not in normalized_content
    ):
        findings.append(
            warning_finding(
                code="PCV-CTL-DELIVERABLE-ID-NOT-FOUND",
                message=(
                    f"Document content does not explicitly identify "
                    f"deliverable {deliverable_id!r}."
                ),
                stage=StageName.PROJECT_CONTROL,
                source=source,
                remediation=(
                    "Add the official deliverable identifier to the "
                    "document metadata."
                ),
            )
        )

    return findings


# =============================================================================
# PROJECT CONTROL CONSISTENCY VALIDATION
# =============================================================================

def validate_project_control(
    context: ValidationContext,
) -> StageResult:
    """Validate cross-document Project Control consistency."""

    result = StageResult(stage=StageName.PROJECT_CONTROL)

    current_state_path = context.resolve_project_control_file(
        "CIPS_CURRENT_STATE.yaml"
    )
    dependency_path = context.resolve_project_control_file(
        "CIPS_DEPENDENCY_MAP.yaml"
    )
    manifest_path = context.resolve_project_control_file(
        "CIPS_FILE_MANIFEST.yaml"
    )

    required_documents = (
        current_state_path,
        dependency_path,
        manifest_path,
    )

    loaded: dict[Path, Mapping[str, Any]] = {}

    for path in required_documents:
        result.checks_executed += 1

        try:
            document = load_document(context, path)
        except ProjectControlValidatorError as exc:
            result.add_finding(
                critical_finding(
                    code="PCV-CTL-DOCUMENT-LOAD-FAILED",
                    message=str(exc),
                    stage=StageName.PROJECT_CONTROL,
                    source=path,
                )
            )
            continue

        if not isinstance(document, Mapping):
            result.add_finding(
                critical_finding(
                    code="PCV-CTL-DOCUMENT-ROOT-TYPE",
                    message=(
                        f"Project Control document {path.name!r} "
                        "must have a mapping root."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=path,
                )
            )
            continue

        loaded[path] = document

    if len(loaded) != len(required_documents):
        return result

    current_state = loaded[current_state_path]
    dependency_map = loaded[dependency_path]
    manifest = loaded[manifest_path]

    current_execution = extract_current_execution_state(
        current_state
    )
    dependency_execution = extract_dependency_execution_state(
        dependency_map
    )

    for field_name in (
        "current_phase",
        "current_deliverable",
        "last_accepted",
        "next_deliverable",
    ):
        result.checks_executed += 1

        current_value = current_execution[field_name]
        dependency_value = dependency_execution[field_name]

        if not dependency_value:
            result.add_finding(
                warning_finding(
                    code="PCV-CTL-DEPENDENCY-STATE-MISSING",
                    message=(
                        f"Dependency Map does not expose current graph "
                        f"field {field_name!r}."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=dependency_path,
                )
            )
            continue

        if current_value != dependency_value:
            result.add_finding(
                error_finding(
                    code="PCV-CTL-EXECUTION-MISMATCH",
                    message=(
                        f"Execution field {field_name!r} differs "
                        "between Current State and Dependency Map."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=current_state_path,
                    remediation=(
                        "Synchronize the documents at the next "
                        "significant Project Control checkpoint."
                    ),
                )
            )

    current_deliverable = current_execution[
        "current_deliverable"
    ]
    current_status = current_execution[
        "current_deliverable_status"
    ]
    last_accepted = current_execution["last_accepted"]
    next_deliverable = current_execution["next_deliverable"]

    result.checks_executed += 1

    if current_status not in VALID_DELIVERABLE_STATES:
        result.add_finding(
            error_finding(
                code="PCV-CTL-CURRENT-STATUS-INVALID",
                message=(
                    f"Current deliverable uses unsupported status "
                    f"{current_status!r}."
                ),
                stage=StageName.PROJECT_CONTROL,
                source=current_state_path,
            )
        )

    deliverable_nodes = context.metadata.get(
        "dependency_deliverable_nodes",
        {},
    )

    if not isinstance(deliverable_nodes, Mapping):
        deliverable_nodes = {}

    for role_name, deliverable_id in (
        ("current", current_deliverable),
        ("last accepted", last_accepted),
        ("next", next_deliverable),
    ):
        result.checks_executed += 1

        if not deliverable_id:
            result.add_finding(
                error_finding(
                    code="PCV-CTL-DELIVERABLE-ID-MISSING",
                    message=(
                        f"The {role_name} deliverable identifier "
                        "is missing from Current State."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=current_state_path,
                )
            )
            continue

        if deliverable_id not in deliverable_nodes:
            result.add_finding(
                error_finding(
                    code="PCV-CTL-DELIVERABLE-NOT-IN-GRAPH",
                    message=(
                        f"The {role_name} deliverable "
                        f"{deliverable_id!r} is not registered in the "
                        "Dependency Map."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=current_state_path,
                )
            )

    ordered_deliverables = context.metadata.get(
        "deliverable_topological_order",
        [],
    )

    if isinstance(ordered_deliverables, Sequence):
        result.checks_executed += 1
        result.add_findings(
            validate_identifier_sequence(
                current_id=current_deliverable,
                previous_id=last_accepted,
                next_id=next_deliverable,
                ordered_ids=[
                    str(item)
                    for item in ordered_deliverables
                ],
                source=current_state_path,
            )
        )

    if current_deliverable in deliverable_nodes:
        node = deliverable_nodes[current_deliverable]

        if isinstance(node, DependencyNode):
            unsatisfied_dependencies: list[str] = []

            for dependency_id in node.dependencies:
                dependency_node = deliverable_nodes.get(
                    dependency_id
                )

                result.checks_executed += 1

                if not isinstance(
                    dependency_node,
                    DependencyNode,
                ):
                    unsatisfied_dependencies.append(
                        dependency_id
                    )
                    continue

                if dependency_node.status != "ACCEPTED":
                    unsatisfied_dependencies.append(
                        dependency_id
                    )

            if unsatisfied_dependencies:
                result.add_finding(
                    error_finding(
                        code="PCV-CTL-DEPENDENCIES-NOT-ACCEPTED",
                        message=(
                            f"Current deliverable "
                            f"{current_deliverable!r} has dependencies "
                            "that are not accepted: "
                            f"{', '.join(unsatisfied_dependencies)}."
                        ),
                        stage=StageName.PROJECT_CONTROL,
                        source=dependency_path,
                        remediation=(
                            "Accept all mandatory dependencies before "
                            "continuing the deliverable."
                        ),
                    )
                )

    manifest_entries = collect_manifest_entries(manifest)
    manifest_statuses = extract_manifest_deliverable_statuses(
        manifest_entries
    )

    for deliverable_id, expected_role in (
        (last_accepted, "last accepted"),
        (current_deliverable, "current"),
        (next_deliverable, "next"),
    ):
        result.checks_executed += 1

        manifest_status = manifest_statuses.get(
            deliverable_id
        )

        if manifest_status is None:
            if deliverable_id == "CTRL-001":
                continue

            result.add_finding(
                warning_finding(
                    code="PCV-CTL-MANIFEST-STATUS-MISSING",
                    message=(
                        f"No File Manifest status was found for the "
                        f"{expected_role} deliverable "
                        f"{deliverable_id!r}."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=manifest_path,
                    remediation=(
                        "Confirm that the deliverable has a registered "
                        "file or explicitly document why it does not."
                    ),
                )
            )
            continue

        if (
            expected_role == "last accepted"
            and manifest_status != "ACCEPTED"
        ):
            result.add_finding(
                error_finding(
                    code="PCV-CTL-LAST-ACCEPTED-MANIFEST-MISMATCH",
                    message=(
                        f"Last accepted deliverable "
                        f"{deliverable_id!r} has manifest status "
                        f"{manifest_status!r}."
                    ),
                    stage=StageName.PROJECT_CONTROL,
                    source=manifest_path,
                )
            )

    authorization = current_state.get(
        "authorization",
        {},
    )

    if isinstance(authorization, Mapping):
        implementation_allowed = authorization.get(
            "implementation_allowed"
        )
        production_code_allowed = authorization.get(
            "production_code_modification_allowed"
        )

        current_phase = current_execution["current_phase"]

        if current_phase == "PHASE-0":
            result.checks_executed += 2

            if implementation_allowed is not False:
                result.add_finding(
                    error_finding(
                        code="PCV-CTL-PHASE-ZERO-IMPLEMENTATION-AUTH",
                        message=(
                            "Current State must keep general "
                            "implementation authorization disabled "
                            "during Phase 0."
                        ),
                        stage=StageName.PROJECT_CONTROL,
                        source=current_state_path,
                    )
                )

            if production_code_allowed is not False:
                result.add_finding(
                    error_finding(
                        code="PCV-CTL-PRODUCTION-CODE-AUTH",
                        message=(
                            "Production code modification must remain "
                            "disabled during Project Control Bootstrap."
                        ),
                        stage=StageName.PROJECT_CONTROL,
                        source=current_state_path,
                    )
                )

    project_control_flags = current_state.get(
        "project_control",
        {},
    )

    if isinstance(project_control_flags, Mapping):
        accepted_flag_map = {
            "current_state_ready": "CTRL-003",
            "delivery_ledger_ready": "CTRL-004",
            "decision_log_ready": "CTRL-005",
            "dependency_map_ready": "CTRL-006",
            "file_manifest_ready": "CTRL-007",
            "session_handoff_ready": "CTRL-008",
            "acceptance_matrix_ready": "CTRL-009",
            "change_control_ready": "CTRL-010",
            "baseline_manifest_ready": "CTRL-011",
            "protected_files_ready": "CTRL-012",
            "risk_register_ready": "CTRL-013",
            "checkpoints_ready": "CTRL-014",
        }

        for flag_name, deliverable_id in accepted_flag_map.items():
            result.checks_executed += 1
            flag_value = project_control_flags.get(
                flag_name
            )
            dependency_node = deliverable_nodes.get(
                deliverable_id
            )

            accepted_in_graph = (
                isinstance(
                    dependency_node,
                    DependencyNode,
                )
                and dependency_node.status == "ACCEPTED"
            )

            if accepted_in_graph and flag_value is not True:
                result.add_finding(
                    warning_finding(
                        code="PCV-CTL-READINESS-FLAG-STALE",
                        message=(
                            f"Current State flag {flag_name!r} is not "
                            f"true although {deliverable_id} is accepted "
                            "in the Dependency Map."
                        ),
                        stage=StageName.PROJECT_CONTROL,
                        source=current_state_path,
                        remediation=(
                            "Update Current State at the next significant "
                            "administrative checkpoint."
                        ),
                    )
                )

    markdown_deliverables: dict[str, str] = {
        "CIPS_MASTER_ROADMAP.md": "CTRL-002",
        "CIPS_DELIVERY_LEDGER.md": "CTRL-004",
        "CIPS_DECISION_LOG.md": "CTRL-005",
        "CIPS_SESSION_HANDOFF.md": "CTRL-008",
        "CIPS_ACCEPTANCE_MATRIX.md": "CTRL-009",
        "CIPS_CHANGE_CONTROL.md": "CTRL-010",
        "CIPS_RISK_REGISTER.md": "CTRL-013",
        "CIPS_CHECKPOINTS.md": "CTRL-014",
    }

    for filename, deliverable_id in markdown_deliverables.items():
        path = context.resolve_project_control_file(
            filename
        )

        if not path.is_file():
            continue

        result.checks_executed += 1

        try:
            content = load_document(context, path)
        except ProjectControlValidatorError as exc:
            result.add_finding(
                error_finding(
                    code="PCV-CTL-MARKDOWN-LOAD-FAILED",
                    message=str(exc),
                    stage=StageName.PROJECT_CONTROL,
                    source=path,
                )
            )
            continue

        if isinstance(content, str):
            result.add_findings(
                validate_markdown_identity(
                    content=content,
                    filename=filename,
                    deliverable_id=deliverable_id,
                    source=path,
                )
            )

    result.checks_executed += 1

    if result.passed:
        result.add_finding(
            info_finding(
                code="PCV-CTL-CONSISTENT",
                message=(
                    "Core Project Control documents are structurally "
                    "consistent."
                ),
                stage=StageName.PROJECT_CONTROL,
                source=current_state_path,
            )
        )

    context.metadata["current_execution_state"] = (
        current_execution
    )
    context.metadata["project_control_validated"] = (
        result.passed
    )

    return result


