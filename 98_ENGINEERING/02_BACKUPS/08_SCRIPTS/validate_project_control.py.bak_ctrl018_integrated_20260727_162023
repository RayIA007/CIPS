def is_relative_to(
    path: Path,
    parent: Path,
) -> bool:
    """Return whether path is contained inside parent."""

    try:
        path.resolve().relative_to(parent.resolve())
    except ValueError:
        return False

    return True


def repository_relative_path(
    context: ValidationContext,
    path: Path,
) -> str:
    """Return a normalized path relative to the project root."""

    try:
        relative = path.resolve().relative_to(
            context.config.project_root.resolve()
        )
    except ValueError:
        return path.as_posix()

    return relative.as_posix()


def resolve_manifest_path(
    context: ValidationContext,
    relative_path: str,
) -> Path:
    """Resolve a manifest path without allowing repository escape."""

    normalized = normalize_relative_path(relative_path)
    candidate = (
        context.config.project_root / Path(normalized)
    ).resolve()

    if not is_relative_to(
        candidate,
        context.config.project_root,
    ):
        raise DocumentLoadError(
            "Manifest path escapes the project root: "
            f"{relative_path!r}"
        )

    return candidate


def validate_mapping_keys(
    *,
    data: Mapping[str, Any],
    required_keys: Iterable[str],
    stage: StageName,
    source: str | Path,
    code_prefix: str,
) -> list[ValidationFinding]:
    """Validate required keys in a mapping."""

    findings: list[ValidationFinding] = []

    for key in required_keys:
        if key in data:
            continue

        findings.append(
            error_finding(
                code=f"{code_prefix}-MISSING-{key.upper()}",
                message=f"Required key {key!r} is missing.",
                stage=stage,
                source=source,
                remediation=(
                    f"Add the required {key!r} field using the "
                    "official Project Control specification."
                ),
            )
        )

    return findings


def collect_manifest_entries(
    manifest: Mapping[str, Any],
) -> dict[str, Mapping[str, Any]]:
    """Collect file records from all supported manifest sections."""

    entries: dict[str, Mapping[str, Any]] = {}

    section_names = (
        "files",
        "reserved_project_control_files",
    )

    for section_name in section_names:
        section = manifest.get(section_name, {})

        if not isinstance(section, Mapping):
            continue

        for raw_file_id, raw_record in section.items():
            file_id = str(raw_file_id)

            if isinstance(raw_record, Mapping):
                entries[file_id] = raw_record

    return entries


def find_manifest_entry_by_filename(
    entries: Mapping[str, Mapping[str, Any]],
    filename: str,
) -> tuple[str, Mapping[str, Any]] | None:
    """Locate a manifest entry by filename."""

    for file_id, record in entries.items():
        if str(record.get("filename", "")).strip() == filename:
            return file_id, record

    return None


def state_means_file_should_exist(state: Any) -> bool:
    """Return whether a manifest state requires a physical file."""

    normalized = normalize_state(state)

    return normalized in {
        "IMPLEMENTED",
        "TESTED",
        "READY_FOR_REVIEW",
        "UNDER_REVIEW",
        "ACCEPTED",
        "SUPERSEDED",
        "DEPRECATED",
        "ARCHIVED",
        "IN_PROGRESS",
    }


