def calculate_file_checksum(
    path: Path,
    algorithm: str = DEFAULT_HASH_ALGORITHM,
) -> str:
    """Calculate a hexadecimal checksum for a repository file."""

    import hashlib

    try:
        hasher = hashlib.new(algorithm)
    except ValueError as exc:
        raise ConfigurationError(
            f"Unsupported checksum algorithm: {algorithm!r}"
        ) from exc

    try:
        with path.open("rb") as file_handle:
            while True:
                chunk = file_handle.read(1024 * 1024)

                if not chunk:
                    break

                hasher.update(chunk)
    except FileNotFoundError as exc:
        raise DocumentLoadError(
            f"Cannot calculate checksum; file does not exist: {path}"
        ) from exc
    except OSError as exc:
        raise DocumentLoadError(
            f"Unable to calculate checksum for {path}: {exc}"
        ) from exc

    return hasher.hexdigest()


def collect_baseline_artifacts(
    baseline_manifest: Mapping[str, Any],
    baseline_id: str,
) -> list[Mapping[str, Any]]:
    """Collect all artifact records registered for one baseline."""

    baseline_artifacts = baseline_manifest.get(
        "baseline_artifacts",
        {},
    )

    if not isinstance(baseline_artifacts, Mapping):
        return []

    raw_baseline = baseline_artifacts.get(
        baseline_id,
        {},
    )

    if not isinstance(raw_baseline, Mapping):
        return []

    artifacts: list[Mapping[str, Any]] = []

    for raw_group in raw_baseline.values():
        if not isinstance(raw_group, Sequence):
            continue

        if isinstance(raw_group, (str, bytes)):
            continue

        for raw_artifact in raw_group:
            if isinstance(raw_artifact, Mapping):
                artifacts.append(raw_artifact)

    return artifacts


def collect_protected_file_records(
    protected_document: Mapping[str, Any],
) -> dict[str, dict[str, Any]]:
    """Collect normalized protected-file records from supported sections."""

    records: dict[str, dict[str, Any]] = {}

    protected_files = protected_document.get(
        "protected_files",
        {},
    )

    if isinstance(protected_files, Mapping):
        for category_name, raw_category in protected_files.items():
            if not isinstance(raw_category, Mapping):
                continue

            category_level = normalize_state(
                raw_category.get("protection_level", "")
            )
            category_owner = str(
                raw_category.get("owner", "")
            ).strip()
            category_files = raw_category.get("files", [])

            if not isinstance(category_files, Sequence):
                continue

            if isinstance(category_files, (str, bytes)):
                continue

            for raw_file in category_files:
                if not isinstance(raw_file, Mapping):
                    continue

                file_id = str(
                    raw_file.get("file_id", "")
                ).strip()

                if not file_id:
                    continue

                records[file_id] = {
                    "file_id": file_id,
                    "filename": str(
                        raw_file.get("filename", "")
                    ).strip(),
                    "protection_level": category_level,
                    "owner": category_owner,
                    "category": str(category_name),
                    "modification_policy": normalize_state(
                        raw_file.get(
                            "modification_policy",
                            "",
                        )
                    ),
                }

    project_control = protected_document.get(
        "project_control",
        {},
    )

    if isinstance(project_control, Mapping):
        protection_level = normalize_state(
            project_control.get("protection_level", "")
        )
        owner = str(
            project_control.get("owner", "")
        ).strip()
        raw_files = project_control.get("files", [])

        if (
            isinstance(raw_files, Sequence)
            and not isinstance(raw_files, (str, bytes))
        ):
            for raw_file in raw_files:
                if not isinstance(raw_file, Mapping):
                    continue

                file_id = str(
                    raw_file.get("file_id", "")
                ).strip()

                if not file_id:
                    continue

                records[file_id] = {
                    "file_id": file_id,
                    "filename": str(
                        raw_file.get("filename", "")
                    ).strip(),
                    "protection_level": protection_level,
                    "owner": owner,
                    "category": "project_control",
                    "modification_policy": (
                        "CHANGE_CONTROL_REQUIRED"
                    ),
                }

    return records


def collect_protected_directories(
    protected_document: Mapping[str, Any],
) -> dict[str, Mapping[str, Any]]:
    """Collect protected-directory declarations."""

    raw_directories = protected_document.get(
        "protected_directories",
        {},
    )

    if not isinstance(raw_directories, Mapping):
        return {}

    return {
        str(directory_id): record
        for directory_id, record in raw_directories.items()
        if isinstance(record, Mapping)
    }


def normalize_boolean(value: Any) -> bool | None:
    """Normalize a strict Boolean value without coercing arbitrary text."""

    if value is True:
        return True

    if value is False:
        return False

    return None


def validate_baseline_registry(
    *,
    result: StageResult,
    baseline_manifest: Mapping[str, Any],
    source: Path,
) -> dict[str, Mapping[str, Any]]:
    """Validate registered baselines and return normalized records."""

    raw_baselines = baseline_manifest.get(
        "baselines",
        {},
    )

    result.checks_executed += 1

    if not isinstance(raw_baselines, Mapping):
        result.add_finding(
            critical_finding(
                code="PCV-BAS-REGISTRY-TYPE",
                message="Baseline registry must be a mapping.",
                stage=StageName.BASELINE,
                source=source,
            )
        )
        return {}

    if not raw_baselines:
        result.add_finding(
            error_finding(
                code="PCV-BAS-REGISTRY-EMPTY",
                message="Baseline registry contains no entries.",
                stage=StageName.BASELINE,
                source=source,
                remediation=(
                    "Register at least the initialization and current "
                    "development baselines."
                ),
            )
        )
        return {}

    baselines: dict[str, Mapping[str, Any]] = {}

    for raw_baseline_id, raw_record in raw_baselines.items():
        baseline_id = str(raw_baseline_id).strip()
        result.checks_executed += 1

        if not baseline_id.startswith("BASELINE-"):
            result.add_finding(
                error_finding(
                    code="PCV-BAS-ID-FORMAT",
                    message=(
                        f"Baseline identifier {baseline_id!r} does not "
                        "follow the BASELINE-XXXXX format."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )

        if not isinstance(raw_record, Mapping):
            result.add_finding(
                error_finding(
                    code="PCV-BAS-RECORD-TYPE",
                    message=(
                        f"Baseline {baseline_id!r} must be a mapping."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )
            continue

        baselines[baseline_id] = raw_record

        required_fields = (
            "name",
            "version",
            "state",
            "status",
        )

        result.checks_executed += len(required_fields)
        result.add_findings(
            validate_mapping_keys(
                data=raw_record,
                required_keys=required_fields,
                stage=StageName.BASELINE,
                source=source,
                code_prefix="PCV-BAS",
            )
        )

        state = normalize_state(
            raw_record.get("state", "")
        )

        result.checks_executed += 1

        if state not in VALID_BASELINE_STATES:
            result.add_finding(
                error_finding(
                    code="PCV-BAS-INVALID-STATE",
                    message=(
                        f"Baseline {baseline_id!r} uses unsupported "
                        f"state {state!r}."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )

    return baselines


def validate_current_baseline(
    *,
    result: StageResult,
    baseline_manifest: Mapping[str, Any],
    baselines: Mapping[str, Mapping[str, Any]],
    current_execution: Mapping[str, str],
    source: Path,
) -> str:
    """Validate the current baseline declaration."""

    raw_current = baseline_manifest.get(
        "current_baseline",
        {},
    )

    result.checks_executed += 1

    if not isinstance(raw_current, Mapping):
        result.add_finding(
            critical_finding(
                code="PCV-BAS-CURRENT-TYPE",
                message="current_baseline must be a mapping.",
                stage=StageName.BASELINE,
                source=source,
            )
        )
        return ""

    baseline_id = str(
        raw_current.get("baseline_id", "")
    ).strip()
    declared_phase = str(
        raw_current.get("phase", "")
    ).strip()
    declared_deliverable = str(
        raw_current.get("active_deliverable", "")
    ).strip()
    declared_state = normalize_state(
        raw_current.get("state", "")
    )

    for field_name, field_value in (
        ("baseline_id", baseline_id),
        ("phase", declared_phase),
        ("active_deliverable", declared_deliverable),
        ("state", declared_state),
    ):
        result.checks_executed += 1

        if not field_value:
            result.add_finding(
                error_finding(
                    code="PCV-BAS-CURRENT-FIELD-MISSING",
                    message=(
                        f"current_baseline.{field_name} is missing."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )

    result.checks_executed += 1

    if baseline_id and baseline_id not in baselines:
        result.add_finding(
            critical_finding(
                code="PCV-BAS-CURRENT-NOT-REGISTERED",
                message=(
                    f"Current baseline {baseline_id!r} is not present "
                    "in the baseline registry."
                ),
                stage=StageName.BASELINE,
                source=source,
            )
        )

    result.checks_executed += 1

    if (
        declared_phase
        and current_execution.get("current_phase")
        and declared_phase != current_execution["current_phase"]
    ):
        result.add_finding(
            error_finding(
                code="PCV-BAS-PHASE-MISMATCH",
                message=(
                    "Current Baseline phase differs from Current State."
                ),
                stage=StageName.BASELINE,
                source=source,
                remediation=(
                    "Synchronize the Baseline Manifest at the next "
                    "significant Project Control checkpoint."
                ),
            )
        )

    result.checks_executed += 1

    if (
        declared_deliverable
        and current_execution.get("current_deliverable")
        and declared_deliverable
        != current_execution["current_deliverable"]
    ):
        result.add_finding(
            error_finding(
                code="PCV-BAS-DELIVERABLE-MISMATCH",
                message=(
                    "Current Baseline active deliverable differs from "
                    "Current State."
                ),
                stage=StageName.BASELINE,
                source=source,
                remediation=(
                    "Synchronize the Baseline Manifest with the current "
                    "execution position."
                ),
            )
        )

    result.checks_executed += 1

    if declared_state not in VALID_BASELINE_STATES:
        result.add_finding(
            error_finding(
                code="PCV-BAS-CURRENT-STATE-INVALID",
                message=(
                    f"Current baseline uses unsupported state "
                    f"{declared_state!r}."
                ),
                stage=StageName.BASELINE,
                source=source,
            )
        )

    return baseline_id


def validate_baseline_artifacts(
    *,
    result: StageResult,
    context: ValidationContext,
    baseline_manifest: Mapping[str, Any],
    baseline_id: str,
    manifest_entries: Mapping[str, Mapping[str, Any]],
    source: Path,
) -> None:
    """Validate artifact references belonging to the current baseline."""

    artifacts = collect_baseline_artifacts(
        baseline_manifest,
        baseline_id,
    )

    result.checks_executed += 1

    if not artifacts:
        result.add_finding(
            warning_finding(
                code="PCV-BAS-NO-ARTIFACTS",
                message=(
                    f"Baseline {baseline_id!r} has no registered "
                    "artifact inventory."
                ),
                stage=StageName.BASELINE,
                source=source,
                remediation=(
                    "Register the mandatory constitutional and Project "
                    "Control artifacts."
                ),
            )
        )
        return

    seen_file_ids: set[str] = set()

    for artifact in artifacts:
        file_id = str(
            artifact.get("file_id", "")
        ).strip()
        filename = str(
            artifact.get("filename", "")
        ).strip()
        expected_status = normalize_state(
            artifact.get("expected_status", "")
        )
        required = normalize_boolean(
            artifact.get("required")
        )

        result.checks_executed += 1

        if not file_id:
            result.add_finding(
                error_finding(
                    code="PCV-BAS-ARTIFACT-ID-MISSING",
                    message="Baseline artifact has no file_id.",
                    stage=StageName.BASELINE,
                    source=source,
                )
            )
            continue

        result.checks_executed += 1

        if file_id in seen_file_ids:
            result.add_finding(
                critical_finding(
                    code="PCV-BAS-DUPLICATE-ARTIFACT",
                    message=(
                        f"Baseline artifact {file_id!r} is registered "
                        "more than once."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )
        else:
            seen_file_ids.add(file_id)

        manifest_record = manifest_entries.get(file_id)
        result.checks_executed += 1

        if not isinstance(manifest_record, Mapping):
            result.add_finding(
                error_finding(
                    code="PCV-BAS-ARTIFACT-NOT-IN-MANIFEST",
                    message=(
                        f"Baseline artifact {file_id!r} is not "
                        "registered in the File Manifest."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )
            continue

        manifest_filename = str(
            manifest_record.get("filename", "")
        ).strip()
        manifest_status = normalize_state(
            manifest_record.get("status", "")
        )
        manifest_relative_path = str(
            manifest_record.get("relative_path", "")
        ).strip()

        result.checks_executed += 1

        if filename and filename != manifest_filename:
            result.add_finding(
                error_finding(
                    code="PCV-BAS-ARTIFACT-NAME-MISMATCH",
                    message=(
                        f"Baseline artifact {file_id!r} declares "
                        f"filename {filename!r}, but the File Manifest "
                        f"declares {manifest_filename!r}."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )

        result.checks_executed += 1

        if (
            expected_status
            and expected_status != manifest_status
        ):
            result.add_finding(
                warning_finding(
                    code="PCV-BAS-ARTIFACT-STATUS-MISMATCH",
                    message=(
                        f"Baseline artifact {file_id!r} expects status "
                        f"{expected_status!r}, but the File Manifest "
                        f"reports {manifest_status!r}."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                    remediation=(
                        "Synchronize Baseline and File Manifest status "
                        "at the next significant checkpoint."
                    ),
                )
            )

        result.checks_executed += 1

        if required is True and manifest_relative_path:
            try:
                artifact_path = resolve_manifest_path(
                    context,
                    manifest_relative_path,
                )
            except DocumentLoadError as exc:
                result.add_finding(
                    error_finding(
                        code="PCV-BAS-ARTIFACT-PATH-INVALID",
                        message=str(exc),
                        stage=StageName.BASELINE,
                        source=source,
                    )
                )
                continue

            if (
                state_means_file_should_exist(
                    manifest_status
                )
                and not artifact_path.is_file()
            ):
                result.add_finding(
                    error_finding(
                        code="PCV-BAS-REQUIRED-ARTIFACT-MISSING",
                        message=(
                            f"Required baseline artifact "
                            f"{file_id!r} does not exist."
                        ),
                        stage=StageName.BASELINE,
                        source=artifact_path,
                    )
                )


def validate_protection_registry(
    *,
    result: StageResult,
    context: ValidationContext,
    protected_document: Mapping[str, Any],
    manifest_entries: Mapping[str, Mapping[str, Any]],
    source: Path,
) -> dict[str, dict[str, Any]]:
    """Validate protected-file and protected-directory declarations."""

    levels = protected_document.get(
        "protection_levels",
        {},
    )

    result.checks_executed += 1

    if not isinstance(levels, Mapping):
        result.add_finding(
            critical_finding(
                code="PCV-BAS-PROTECTION-LEVELS-MISSING",
                message="Protection levels must be a mapping.",
                stage=StageName.BASELINE,
                source=source,
            )
        )
    else:
        for level_name in VALID_PROTECTION_LEVELS:
            result.checks_executed += 1

            if level_name not in levels:
                result.add_finding(
                    error_finding(
                        code="PCV-BAS-PROTECTION-LEVEL-MISSING",
                        message=(
                            f"Protection level {level_name!r} is not "
                            "defined."
                        ),
                        stage=StageName.BASELINE,
                        source=source,
                    )
                )

    records = collect_protected_file_records(
        protected_document
    )

    result.checks_executed += 1

    if not records:
        result.add_finding(
            critical_finding(
                code="PCV-BAS-PROTECTED-REGISTRY-EMPTY",
                message="Protected-file registry contains no records.",
                stage=StageName.BASELINE,
                source=source,
            )
        )
        return {}

    for file_id, record in records.items():
        result.checks_executed += 1

        if file_id not in manifest_entries:
            result.add_finding(
                error_finding(
                    code="PCV-BAS-PROTECTED-NOT-IN-MANIFEST",
                    message=(
                        f"Protected file {file_id!r} is not registered "
                        "in the File Manifest."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )
            continue

        manifest_record = manifest_entries[file_id]
        protected_filename = str(
            record.get("filename", "")
        ).strip()
        manifest_filename = str(
            manifest_record.get("filename", "")
        ).strip()
        protection_level = normalize_state(
            record.get("protection_level", "")
        )

        result.checks_executed += 1

        if protected_filename != manifest_filename:
            result.add_finding(
                error_finding(
                    code="PCV-BAS-PROTECTED-NAME-MISMATCH",
                    message=(
                        f"Protected registry filename "
                        f"{protected_filename!r} does not match "
                        f"File Manifest entry {manifest_filename!r}."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )

        result.checks_executed += 1

        if protection_level not in VALID_PROTECTION_LEVELS:
            result.add_finding(
                error_finding(
                    code="PCV-BAS-PROTECTION-LEVEL-INVALID",
                    message=(
                        f"Protected file {file_id!r} uses invalid "
                        f"protection level {protection_level!r}."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )

        relative_path = str(
            manifest_record.get("relative_path", "")
        ).strip()
        status = normalize_state(
            manifest_record.get("status", "")
        )

        if relative_path and state_means_file_should_exist(status):
            result.checks_executed += 1

            try:
                physical_path = resolve_manifest_path(
                    context,
                    relative_path,
                )
            except DocumentLoadError as exc:
                result.add_finding(
                    error_finding(
                        code="PCV-BAS-PROTECTED-PATH-INVALID",
                        message=str(exc),
                        stage=StageName.BASELINE,
                        source=source,
                    )
                )
                continue

            if not physical_path.is_file():
                result.add_finding(
                    error_finding(
                        code="PCV-BAS-PROTECTED-FILE-MISSING",
                        message=(
                            f"Protected file {file_id!r} is missing "
                            "from its registered location."
                        ),
                        stage=StageName.BASELINE,
                        source=physical_path,
                    )
                )

    protected_directories = collect_protected_directories(
        protected_document
    )

    for directory_id, directory_record in (
        protected_directories.items()
    ):
        raw_path = str(
            directory_record.get("path", "")
        ).strip()
        level = normalize_state(
            directory_record.get(
                "protection_level",
                "",
            )
        )

        result.checks_executed += 1

        if not raw_path:
            result.add_finding(
                error_finding(
                    code="PCV-BAS-PROTECTED-DIRECTORY-PATH",
                    message=(
                        f"Protected directory {directory_id!r} has "
                        "no path."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )
            continue

        result.checks_executed += 1

        if level not in VALID_PROTECTION_LEVELS:
            result.add_finding(
                error_finding(
                    code="PCV-BAS-PROTECTED-DIRECTORY-LEVEL",
                    message=(
                        f"Protected directory {directory_id!r} uses "
                        f"invalid level {level!r}."
                    ),
                    stage=StageName.BASELINE,
                    source=source,
                )
            )

    return records


