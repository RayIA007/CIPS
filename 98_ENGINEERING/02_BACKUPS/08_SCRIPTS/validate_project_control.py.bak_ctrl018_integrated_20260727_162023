# BASELINE AND PROTECTED-FILE VALIDATION
# =============================================================================

def validate_baseline(
    context: ValidationContext,
) -> StageResult:
    """Validate baseline and protected-file integrity."""

    result = StageResult(stage=StageName.BASELINE)

    baseline_path = context.resolve_project_control_file(
        "CIPS_BASELINE_MANIFEST.yaml"
    )
    protected_path = context.resolve_project_control_file(
        "CIPS_PROTECTED_FILES.yaml"
    )
    manifest_path = context.resolve_project_control_file(
        "CIPS_FILE_MANIFEST.yaml"
    )

    loaded_documents: dict[Path, Mapping[str, Any]] = {}

    for path in (
        baseline_path,
        protected_path,
        manifest_path,
    ):
        result.checks_executed += 1

        try:
            document = load_document(
                context,
                path,
            )
        except ProjectControlValidatorError as exc:
            result.add_finding(
                critical_finding(
                    code="PCV-BAS-DOCUMENT-LOAD-FAILED",
                    message=str(exc),
                    stage=StageName.BASELINE,
                    source=path,
                )
            )
            continue

        if not isinstance(document, Mapping):
            result.add_finding(
                critical_finding(
                    code="PCV-BAS-DOCUMENT-ROOT-TYPE",
                    message=(
                        f"Document {path.name!r} must use a mapping "
                        "at its root."
                    ),
                    stage=StageName.BASELINE,
                    source=path,
                )
            )
            continue

        loaded_documents[path] = document

    if len(loaded_documents) != 3:
        return result

    baseline_manifest = loaded_documents[
        baseline_path
    ]
    protected_document = loaded_documents[
        protected_path
    ]
    file_manifest = loaded_documents[
        manifest_path
    ]

    manifest_entries = context.metadata.get(
        "manifest_entries",
    )

    if not isinstance(manifest_entries, Mapping):
        manifest_entries = collect_manifest_entries(
            file_manifest
        )

    baselines = validate_baseline_registry(
        result=result,
        baseline_manifest=baseline_manifest,
        source=baseline_path,
    )

    current_execution = context.metadata.get(
        "current_execution_state",
        {},
    )

    if not isinstance(current_execution, Mapping):
        current_execution = {}

    current_baseline_id = validate_current_baseline(
        result=result,
        baseline_manifest=baseline_manifest,
        baselines=baselines,
        current_execution={
            str(key): str(value)
            for key, value in current_execution.items()
        },
        source=baseline_path,
    )

    if current_baseline_id:
        validate_baseline_artifacts(
            result=result,
            context=context,
            baseline_manifest=baseline_manifest,
            baseline_id=current_baseline_id,
            manifest_entries=manifest_entries,
            source=baseline_path,
        )

    protected_records = validate_protection_registry(
        result=result,
        context=context,
        protected_document=protected_document,
        manifest_entries=manifest_entries,
        source=protected_path,
    )

    current_certification = baseline_manifest.get(
        "current_certification_status",
        {},
    )

    if isinstance(current_certification, Mapping):
        declared_baseline_id = str(
            current_certification.get(
                "baseline_id",
                "",
            )
        ).strip()

        result.checks_executed += 1

        if (
            declared_baseline_id
            and current_baseline_id
            and declared_baseline_id != current_baseline_id
        ):
            result.add_finding(
                error_finding(
                    code="PCV-BAS-CERTIFICATION-ID-MISMATCH",
                    message=(
                        "Current certification status references a "
                        "different baseline than current_baseline."
                    ),
                    stage=StageName.BASELINE,
                    source=baseline_path,
                )
            )

        certification_ready = normalize_boolean(
            current_certification.get(
                "certification_ready"
            )
        )
        pending_gates = ensure_string_list(
            current_certification.get(
                "pending_gates",
                [],
            )
        )

        result.checks_executed += 1

        if (
            certification_ready is True
            and pending_gates
        ):
            result.add_finding(
                error_finding(
                    code="PCV-BAS-CERTIFICATION-CONTRADICTION",
                    message=(
                        "Baseline is marked certification-ready while "
                        "pending certification gates remain."
                    ),
                    stage=StageName.BASELINE,
                    source=baseline_path,
                )
            )

    result.checks_executed += 1

    if result.passed:
        result.add_finding(
            info_finding(
                code="PCV-BAS-INTEGRITY-VALID",
                message=(
                    "Baseline and protected-file registries passed "
                    "structural integrity validation."
                ),
                stage=StageName.BASELINE,
                source=baseline_path,
            )
        )

    context.metadata["baseline_registry"] = baselines
    context.metadata["current_baseline_id"] = (
        current_baseline_id
    )
    context.metadata["protected_file_records"] = (
        protected_records
    )
    context.metadata["baseline_validated"] = (
        result.passed
    )

    return result


