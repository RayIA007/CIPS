@dataclass(frozen=True, slots=True)
class ValidationFinding:
    """Single validation finding produced by a check."""

    code: str
    message: str
    severity: ValidationSeverity
    stage: StageName
    source: str | None = None
    field: str | None = None
    expected: Any | None = None
    actual: Any | None = None
    remediation: str | None = None

    @property
    def is_failure(self) -> bool:
        """Return True when the finding invalidates certification."""

        return self.severity in {
            ValidationSeverity.ERROR,
            ValidationSeverity.CRITICAL,
        }

    def to_dict(self) -> dict[str, Any]:
        """Serialize the finding for JSON reporting."""

        return {
            "code": self.code,
            "message": self.message,
            "severity": self.severity.value,
            "stage": self.stage.value,
            "source": self.source,
            "field": self.field,
            "expected": self.expected,
            "actual": self.actual,
            "remediation": self.remediation,
        }


@dataclass(slots=True)
class StageResult:
    """Validation result for one pipeline stage."""

    stage: StageName
    status: ValidationStatus = ValidationStatus.PASS
    findings: list[ValidationFinding] = field(default_factory=list)
    checks_executed: int = 0
    started_at: datetime | None = None
    finished_at: datetime | None = None
    duration_seconds: float = 0.0

    @property
    def errors(self) -> int:
        """Return the number of error findings."""

        return sum(
            finding.severity is ValidationSeverity.ERROR
            for finding in self.findings
        )

    @property
    def critical_errors(self) -> int:
        """Return the number of critical findings."""

        return sum(
            finding.severity is ValidationSeverity.CRITICAL
            for finding in self.findings
        )

    @property
    def warnings(self) -> int:
        """Return the number of warning findings."""

        return sum(
            finding.severity is ValidationSeverity.WARNING
            for finding in self.findings
        )

    @property
    def information(self) -> int:
        """Return the number of informational findings."""

        return sum(
            finding.severity is ValidationSeverity.INFO
            for finding in self.findings
        )

    @property
    def passed(self) -> bool:
        """Return True when the stage has no blocking findings."""

        return not any(finding.is_failure for finding in self.findings)

    def add_finding(self, finding: ValidationFinding) -> None:
        """Add a finding and recalculate stage status."""

        if finding.stage is not self.stage:
            raise ValueError(
                "Finding stage does not match StageResult stage: "
                f"{finding.stage.value!r} != {self.stage.value!r}"
            )

        self.findings.append(finding)
        self._recalculate_status()

    def add_findings(
        self,
        findings: Iterable[ValidationFinding],
    ) -> None:
        """Add multiple findings."""

        for finding in findings:
            self.add_finding(finding)

    def _recalculate_status(self) -> None:
        """Recalculate the stage status from its findings."""

        if any(
            finding.severity is ValidationSeverity.CRITICAL
            for finding in self.findings
        ):
            self.status = ValidationStatus.FAIL
            return

        if any(
            finding.severity is ValidationSeverity.ERROR
            for finding in self.findings
        ):
            self.status = ValidationStatus.FAIL
            return

        if any(
            finding.severity is ValidationSeverity.WARNING
            for finding in self.findings
        ):
            self.status = ValidationStatus.WARNING
            return

        self.status = ValidationStatus.PASS

    def to_dict(self) -> dict[str, Any]:
        """Serialize the stage result."""

        return {
            "stage": self.stage.value,
            "status": self.status.value,
            "checks_executed": self.checks_executed,
            "errors": self.errors,
            "critical_errors": self.critical_errors,
            "warnings": self.warnings,
            "information": self.information,
            "started_at": (
                self.started_at.isoformat()
                if self.started_at is not None
                else None
            ),
            "finished_at": (
                self.finished_at.isoformat()
                if self.finished_at is not None
                else None
            ),
            "duration_seconds": round(self.duration_seconds, 6),
            "findings": [
                finding.to_dict()
                for finding in self.findings
            ],
        }


@dataclass(slots=True)
class ValidationReport:
    """Complete Project Control validation report."""

    validator_name: str = VALIDATOR_NAME
    validator_version: str = VALIDATOR_VERSION
    deliverable_id: str = DELIVERABLE_ID
    project_name: str = PROJECT_NAME
    project_root: Path = PROJECT_ROOT
    started_at: datetime = field(
        default_factory=lambda: datetime.now(timezone.utc)
    )
    finished_at: datetime | None = None
    duration_seconds: float = 0.0
    stages: list[StageResult] = field(default_factory=list)

    @property
    def findings(self) -> list[ValidationFinding]:
        """Return all findings from all stages."""

        return [
            finding
            for stage in self.stages
            for finding in stage.findings
        ]

    @property
    def errors(self) -> int:
        """Return the number of noncritical errors."""

        return sum(stage.errors for stage in self.stages)

    @property
    def critical_errors(self) -> int:
        """Return the number of critical errors."""

        return sum(stage.critical_errors for stage in self.stages)

    @property
    def warnings(self) -> int:
        """Return the number of warnings."""

        return sum(stage.warnings for stage in self.stages)

    @property
    def checks_executed(self) -> int:
        """Return the total number of executed checks."""

        return sum(stage.checks_executed for stage in self.stages)

    @property
    def status(self) -> ValidationStatus:
        """Calculate the final validation status."""

        if any(
            stage.status is ValidationStatus.FAIL
            for stage in self.stages
        ):
            return ValidationStatus.FAIL

        if any(
            stage.status is ValidationStatus.WARNING
            for stage in self.stages
        ):
            return ValidationStatus.WARNING

        if self.stages and all(
            stage.status is ValidationStatus.SKIPPED
            for stage in self.stages
        ):
            return ValidationStatus.SKIPPED

        return ValidationStatus.PASS

    def add_stage(self, stage_result: StageResult) -> None:
        """Add a completed stage result."""

        self.stages.append(stage_result)

    def finish(self) -> None:
        """Mark the report as completed."""

        self.finished_at = datetime.now(timezone.utc)
        self.duration_seconds = (
            self.finished_at - self.started_at
        ).total_seconds()

    def to_dict(self) -> dict[str, Any]:
        """Serialize the complete report."""

        return {
            "validator": {
                "name": self.validator_name,
                "version": self.validator_version,
                "deliverable_id": self.deliverable_id,
            },
            "project": {
                "name": self.project_name,
                "root": str(self.project_root),
            },
            "result": {
                "status": self.status.value,
                "checks_executed": self.checks_executed,
                "errors": self.errors,
                "critical_errors": self.critical_errors,
                "warnings": self.warnings,
            },
            "execution": {
                "started_at": self.started_at.isoformat(),
                "finished_at": (
                    self.finished_at.isoformat()
                    if self.finished_at is not None
                    else None
                ),
                "duration_seconds": round(self.duration_seconds, 6),
            },
            "stages": [
                stage.to_dict()
                for stage in self.stages
            ],
        }


@dataclass(frozen=True, slots=True)
class ValidatorConfig:
    """Immutable runtime configuration."""

    project_root: Path
    production_system_root: Path
    architecture_directory: Path
    project_control_directory: Path
    scripts_directory: Path
    strict: bool = False
    fail_fast: bool = False
    verbose: bool = False
    output_format: str = "text"
    report_path: Path | None = None

    def validate(self) -> None:
        """Validate the runtime configuration."""

        if self.output_format not in {"text", "json"}:
            raise ConfigurationError(
                "Unsupported output format: "
                f"{self.output_format!r}. Expected 'text' or 'json'."
            )

        if not self.project_root.is_absolute():
            raise ConfigurationError(
                "Project root must be an absolute path."
            )

        if self.report_path is not None and self.report_path.is_dir():
            raise ConfigurationError(
                "Report path must point to a file, not a directory."
            )


@dataclass(slots=True)
class ValidationContext:
    """Shared read-only-oriented context for all validation stages."""

    config: ValidatorConfig
    loaded_documents: dict[Path, Any] = field(default_factory=dict)
    metadata: dict[str, Any] = field(default_factory=dict)

    def resolve_architecture_file(self, filename: str) -> Path:
        """Resolve a constitutional document path."""

        return self.config.architecture_directory / filename

    def resolve_project_control_file(self, filename: str) -> Path:
        """Resolve a Project Control document path."""

        return self.config.project_control_directory / filename

    def remember_document(self, path: Path, document: Any) -> None:
        """Cache a loaded document by its canonical path."""

        self.loaded_documents[path.resolve()] = document

    def get_document(self, path: Path) -> Any | None:
        """Return a cached document when available."""

        return self.loaded_documents.get(path.resolve())


