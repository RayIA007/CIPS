class FindingDisposition(str, Enum):
    """
    Decision produced by a normalization rule for one finding.

    KEEP:
        Preserve the finding without changes.

    REMOVE:
        Remove a legacy or contextually invalid finding.

    REPLACE:
        Replace the original finding with a normalized finding.
    """

    KEEP = "KEEP"
    REMOVE = "REMOVE"
    REPLACE = "REPLACE"


@dataclass(frozen=True, slots=True)
class FindingDecision:
    """
    Immutable decision returned by one normalization rule.
    """

    disposition: FindingDisposition
    replacement: ValidationFinding | None = None
    reason: str | None = None

    def __post_init__(self) -> None:
        if (
            self.disposition is FindingDisposition.REPLACE
            and self.replacement is None
        ):
            raise ValueError(
                "REPLACE decisions require a replacement finding."
            )

        if (
            self.disposition is not FindingDisposition.REPLACE
            and self.replacement is not None
        ):
            raise ValueError(
                "Only REPLACE decisions may include a replacement finding."
            )

    @classmethod
    def keep(
        cls,
        *,
        reason: str | None = None,
    ) -> "FindingDecision":
        return cls(
            disposition=FindingDisposition.KEEP,
            reason=reason,
        )

    @classmethod
    def remove(
        cls,
        *,
        reason: str,
    ) -> "FindingDecision":
        return cls(
            disposition=FindingDisposition.REMOVE,
            reason=reason,
        )

    @classmethod
    def replace(
        cls,
        *,
        replacement: ValidationFinding,
        reason: str,
    ) -> "FindingDecision":
        return cls(
            disposition=FindingDisposition.REPLACE,
            replacement=replacement,
            reason=reason,
        )


@dataclass(frozen=True, slots=True)
class ResultNormalizationContext:
    """
    Read-only context supplied to every result-normalization rule.

    The class separates normalization inputs from the mutable validator
    execution context. Rules may inspect repository state but may not
    modify project documents.
    """

    validation_context: ValidationContext
    stage: StageName
    original_findings: tuple[ValidationFinding, ...]
    metadata: Mapping[str, Any]

    @classmethod
    def from_stage(
        cls,
        *,
        validation_context: ValidationContext,
        stage_result: StageResult,
    ) -> "ResultNormalizationContext":
        return cls(
            validation_context=validation_context,
            stage=stage_result.stage,
            original_findings=tuple(stage_result.findings),
            metadata=dict(validation_context.metadata),
        )


@dataclass(frozen=True, slots=True)
class FindingNormalizationRule:
    """
    Declarative rule used by ResultNormalizer.

    A rule is evaluated only for the configured stages and finding codes.
    The predicate receives the finding and the immutable normalization
    context. It must return True only when the rule is applicable.
    """

    rule_id: str
    stages: frozenset[StageName]
    finding_codes: frozenset[str]
    predicate: Callable[
        [ValidationFinding, ResultNormalizationContext],
        bool,
    ]
    decision_factory: Callable[
        [ValidationFinding, ResultNormalizationContext],
        FindingDecision,
    ]
    priority: int = 100

    def applies_to(
        self,
        *,
        finding: ValidationFinding,
        context: ResultNormalizationContext,
    ) -> bool:
        if context.stage not in self.stages:
            return False

        if (
            self.finding_codes
            and finding.code not in self.finding_codes
        ):
            return False

        return bool(
            self.predicate(
                finding,
                context,
            )
        )


