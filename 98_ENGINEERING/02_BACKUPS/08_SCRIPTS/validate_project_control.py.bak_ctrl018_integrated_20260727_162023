def validate_dependencies(
    context: ValidationContext,
) -> StageResult:
    """Validate the official dependency graph."""

    result = StageResult(stage=StageName.DEPENDENCIES)
    dependency_path = context.resolve_project_control_file(
        "CIPS_DEPENDENCY_MAP.yaml"
    )

    try:
        raw_dependency_map = load_document(
            context,
            dependency_path,
        )
    except ProjectControlValidatorError as exc:
        result.checks_executed += 1
        result.add_finding(
            critical_finding(
                code="PCV-DEP-LOAD-FAILED",
                message=str(exc),
                stage=StageName.DEPENDENCIES,
                source=dependency_path,
                remediation=(
                    "Correct the Dependency Map before continuing."
                ),
            )
        )
        return result

    result.checks_executed += 1

    if not isinstance(raw_dependency_map, Mapping):
        result.add_finding(
            critical_finding(
                code="PCV-DEP-ROOT-TYPE",
                message="Dependency Map root must be a mapping.",
                stage=StageName.DEPENDENCIES,
                source=dependency_path,
            )
        )
        return result

    dependency_model = raw_dependency_map.get(
        "dependency_model",
        {},
    )

    result.checks_executed += 1

    if not isinstance(dependency_model, Mapping):
        result.add_finding(
            error_finding(
                code="PCV-DEP-MODEL-MISSING",
                message=(
                    "Dependency Map does not contain a valid "
                    "'dependency_model' section."
                ),
                stage=StageName.DEPENDENCIES,
                source=dependency_path,
            )
        )
    else:
        graph_type = normalize_state(
            dependency_model.get("graph_type", "")
        )
        directed = dependency_model.get("directed")
        acyclic = dependency_model.get("acyclic")

        result.checks_executed += 3

        if graph_type != "DAG":
            result.add_finding(
                error_finding(
                    code="PCV-DEP-GRAPH-TYPE",
                    message=(
                        "dependency_model.graph_type must be 'DAG'."
                    ),
                    stage=StageName.DEPENDENCIES,
                    source=dependency_path,
                    remediation=(
                        "Declare the official graph type as DAG."
                    ),
                )
            )

        if directed is not True:
            result.add_finding(
                error_finding(
                    code="PCV-DEP-NOT-DIRECTED",
                    message=(
                        "dependency_model.directed must be true."
                    ),
                    stage=StageName.DEPENDENCIES,
                    source=dependency_path,
                )
            )

        if acyclic is not True:
            result.add_finding(
                error_finding(
                    code="PCV-DEP-NOT-ACYCLIC",
                    message=(
                        "dependency_model.acyclic must be true."
                    ),
                    stage=StageName.DEPENDENCIES,
                    source=dependency_path,
                )
            )

    deliverable_nodes = collect_dependency_nodes(
        raw_dependency_map,
        ("deliverables",),
    )

    phase_nodes, duplicate_phase_sources = merge_dependency_nodes(
        collect_dependency_nodes(
            raw_dependency_map,
            ("phases",),
        ),
        collect_dependency_nodes(
            raw_dependency_map,
            ("remaining_phases",),
        ),
    )

    result.checks_executed += 1

    for node_id, sections in duplicate_phase_sources.items():
        result.add_finding(
            critical_finding(
                code="PCV-DEP-DUPLICATE-PHASE",
                message=(
                    f"Phase {node_id!r} is declared in multiple "
                    f"sections: {', '.join(sections)}."
                ),
                stage=StageName.DEPENDENCIES,
                source=dependency_path,
                remediation=(
                    "Maintain exactly one authoritative phase record."
                ),
            )
        )

    deliverable_order = validate_dependency_graph_group(
        result=result,
        nodes=deliverable_nodes,
        graph_name="deliverables",
        source=dependency_path,
        valid_states=VALID_DELIVERABLE_STATES,
    )

    phase_order = validate_dependency_graph_group(
        result=result,
        nodes=phase_nodes,
        graph_name="phases",
        source=dependency_path,
        valid_states=VALID_PHASE_STATES,
    )

    expected_phase_zero = set(
        EXPECTED_PHASE_ZERO_DELIVERABLES
    )
    registered_phase_zero = {
        node_id
        for node_id, node in deliverable_nodes.items()
        if node_id.startswith("CTRL-")
    }

    result.checks_executed += 1

    missing_phase_zero = sorted(
        expected_phase_zero - registered_phase_zero
    )

    if missing_phase_zero:
        result.add_finding(
            error_finding(
                code="PCV-DEP-PHASE-ZERO-MISSING",
                message=(
                    "Dependency Map is missing Phase 0 deliverables: "
                    f"{', '.join(missing_phase_zero)}."
                ),
                stage=StageName.DEPENDENCIES,
                source=dependency_path,
                remediation=(
                    "Register all CTRL-001 through CTRL-015 "
                    "deliverables."
                ),
            )
        )

    result.checks_executed += 1

    unexpected_phase_zero = sorted(
        registered_phase_zero - expected_phase_zero
    )

    if unexpected_phase_zero:
        result.add_finding(
            warning_finding(
                code="PCV-DEP-PHASE-ZERO-UNEXPECTED",
                message=(
                    "Dependency Map contains additional CTRL "
                    "deliverables not declared in the current Phase 0 "
                    f"contract: {', '.join(unexpected_phase_zero)}."
                ),
                stage=StageName.DEPENDENCIES,
                source=dependency_path,
                remediation=(
                    "Confirm that every additional deliverable is "
                    "authorized by the official Roadmap."
                ),
            )
        )

    execution_order = nested_get(
        raw_dependency_map,
        ("phase_execution_order", "ordered_phases"),
        default=[],
    )
    normalized_execution_order = ensure_string_list(
        execution_order
    )

    result.checks_executed += 1

    if normalized_execution_order:
        registered_phase_ids = set(phase_nodes)
        declared_phase_ids = set(normalized_execution_order)

        missing_from_order = sorted(
            registered_phase_ids - declared_phase_ids
        )
        unknown_in_order = sorted(
            declared_phase_ids - registered_phase_ids
        )

        if missing_from_order:
            result.add_finding(
                error_finding(
                    code="PCV-DEP-PHASE-ORDER-INCOMPLETE",
                    message=(
                        "Phase execution order omits registered phases: "
                        f"{', '.join(missing_from_order)}."
                    ),
                    stage=StageName.DEPENDENCIES,
                    source=dependency_path,
                )
            )

        if unknown_in_order:
            result.add_finding(
                error_finding(
                    code="PCV-DEP-PHASE-ORDER-UNKNOWN",
                    message=(
                        "Phase execution order references unknown phases: "
                        f"{', '.join(unknown_in_order)}."
                    ),
                    stage=StageName.DEPENDENCIES,
                    source=dependency_path,
                )
            )

        if (
            not missing_from_order
            and not unknown_in_order
            and phase_order
        ):
            order_positions = {
                phase_id: index
                for index, phase_id in enumerate(
                    normalized_execution_order
                )
            }

            for phase_id, phase_node in phase_nodes.items():
                for dependency in phase_node.dependencies:
                    if dependency not in order_positions:
                        continue

                    result.checks_executed += 1

                    if (
                        order_positions[dependency]
                        >= order_positions[phase_id]
                    ):
                        result.add_finding(
                            critical_finding(
                                code="PCV-DEP-PHASE-ORDER-VIOLATION",
                                message=(
                                    f"Phase {phase_id!r} appears before "
                                    f"or at the same position as dependency "
                                    f"{dependency!r}."
                                ),
                                stage=StageName.DEPENDENCIES,
                                source=dependency_path,
                                remediation=(
                                    "Reorder phases so every dependency "
                                    "precedes its consumer."
                                ),
                            )
                        )

    current_graph_state = raw_dependency_map.get(
        "current_graph_state",
        {},
    )

    if isinstance(current_graph_state, Mapping):
        current_deliverable = str(
            current_graph_state.get(
                "current_deliverable",
                "",
            )
        ).strip()
        last_accepted = str(
            current_graph_state.get(
                "last_accepted_deliverable",
                "",
            )
        ).strip()
        next_deliverable = str(
            current_graph_state.get(
                "next_deliverable",
                "",
            )
        ).strip()

        for field_name, deliverable_id in (
            ("current_deliverable", current_deliverable),
            ("last_accepted_deliverable", last_accepted),
            ("next_deliverable", next_deliverable),
        ):
            result.checks_executed += 1

            if (
                deliverable_id
                and deliverable_id not in deliverable_nodes
            ):
                result.add_finding(
                    error_finding(
                        code="PCV-DEP-CURRENT-STATE-REFERENCE",
                        message=(
                            f"current_graph_state.{field_name} "
                            f"references unknown deliverable "
                            f"{deliverable_id!r}."
                        ),
                        stage=StageName.DEPENDENCIES,
                        source=dependency_path,
                    )
                )

    context.metadata["dependency_deliverable_nodes"] = (
        deliverable_nodes
    )
    context.metadata["dependency_phase_nodes"] = phase_nodes
    context.metadata["deliverable_topological_order"] = (
        deliverable_order
    )
    context.metadata["phase_topological_order"] = phase_order
    context.metadata["dependencies_validated"] = result.passed

    return result


