class ValidationPipeline:
    """Deterministic orchestrator for Project Control validation stages."""

    def __init__(
        self,
        context: ValidationContext,
        stages: Sequence[PipelineStage],
    ) -> None:
        self._context = context
        self._stages = tuple(stages)

    def run(self) -> ValidationReport:
        """Execute all registered stages in order."""

        report = ValidationReport(
            project_root=self._context.config.project_root,
        )

        for pipeline_stage in self._stages:
            stage_result = self._run_stage(pipeline_stage)
            report.add_stage(stage_result)

            if self._must_stop(
                pipeline_stage=pipeline_stage,
                stage_result=stage_result,
            ):
                break

        report.finish()
        return report

    def _run_stage(
        self,
        pipeline_stage: PipelineStage,
    ) -> StageResult:
        """Execute one stage with controlled error handling."""

        started_at = datetime.now(timezone.utc)
        started_timer = time.perf_counter()

        try:
            result = pipeline_stage.validator(self._context)

            if result.stage is not pipeline_stage.name:
                raise ValidationExecutionError(
                    "Validator returned an unexpected stage. "
                    f"Expected {pipeline_stage.name.value!r}, "
                    f"received {result.stage.value!r}."
                )

        except ProjectControlValidatorError as exc:
            result = StageResult(stage=pipeline_stage.name)
            result.add_finding(
                critical_finding(
                    code="PCV-STAGE-CONTROLLED-FAILURE",
                    message=str(exc),
                    stage=pipeline_stage.name,
                    remediation=(
                        "Correct the reported project configuration or "
                        "document error and rerun the validator."
                    ),
                )
            )

        except Exception as exc:  # Defensive boundary for CLI execution.
            result = StageResult(stage=pipeline_stage.name)
            result.add_finding(
                critical_finding(
                    code="PCV-STAGE-UNEXPECTED-FAILURE",
                    message=(
                        f"Unexpected failure in stage "
                        f"{pipeline_stage.name.value!r}: "
                        f"{type(exc).__name__}: {exc}"
                    ),
                    stage=pipeline_stage.name,
                    remediation=(
                        "Inspect the validator implementation and preserve "
                        "the repository state before retrying."
                    ),
                )
            )

        finished_at = datetime.now(timezone.utc)

        result.started_at = started_at
        result.finished_at = finished_at
        result.duration_seconds = time.perf_counter() - started_timer

        return result

    def _must_stop(
        self,
        *,
        pipeline_stage: PipelineStage,
        stage_result: StageResult,
    ) -> bool:
        """Determine whether pipeline execution must stop."""

        if (
            pipeline_stage.required
            and stage_result.status is ValidationStatus.FAIL
            and self._context.config.fail_fast
        ):
            return True

        if (
            pipeline_stage.stop_on_critical
            and stage_result.critical_errors > 0
        ):
            return True

        return False


