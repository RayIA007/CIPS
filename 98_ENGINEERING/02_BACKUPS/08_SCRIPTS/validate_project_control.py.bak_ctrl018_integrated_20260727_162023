# CTRL-016 COMPATIBILITY — TERMINAL DEPENDENCY GRAPH
# =============================================================================

_TERMINAL_GRAPH_VALUES = {
    "",
    "NONE",
    "END",
    "END_OF_GRAPH",
    "NOT_APPLICABLE",
}


def _terminal_value(value: Any) -> bool:
    return str(value if value is not None else "").strip().upper() in (
        _TERMINAL_GRAPH_VALUES
    )


def _dependency_topological_order(
    raw_deliverables: Mapping[str, Any],
) -> list[str]:
    """
    Build a deterministic dependency-first order for terminal-state checks.
    """

    dependencies: dict[str, list[str]] = {}
    source_order: dict[str, int] = {}

    for index, (raw_id, raw_record) in enumerate(
        raw_deliverables.items()
    ):
        deliverable_id = str(raw_id).strip()

        if not deliverable_id or not isinstance(raw_record, Mapping):
            continue

        raw_dependencies = raw_record.get("dependencies", [])

        if isinstance(raw_dependencies, str):
            raw_dependencies = [raw_dependencies]

        if not isinstance(raw_dependencies, Sequence):
            raw_dependencies = []

        dependencies[deliverable_id] = [
            str(item).strip()
            for item in raw_dependencies
            if str(item).strip()
        ]
        source_order[deliverable_id] = index

    counts = {
        deliverable_id: len(
            [
                dependency_id
                for dependency_id in dependency_ids
                if dependency_id in dependencies
            ]
        )
        for deliverable_id, dependency_ids in dependencies.items()
    }

    dependents = {
        deliverable_id: []
        for deliverable_id in dependencies
    }

    for deliverable_id, dependency_ids in dependencies.items():
        for dependency_id in dependency_ids:
            if dependency_id in dependents:
                dependents[dependency_id].append(deliverable_id)

    ready = sorted(
        [
            deliverable_id
            for deliverable_id, count in counts.items()
            if count == 0
        ],
        key=lambda item: (
            source_order.get(item, 0),
            item,
        ),
    )

    ordered: list[str] = []

    while ready:
        current = ready.pop(0)
        ordered.append(current)

        for dependent_id in sorted(
            dependents.get(current, []),
            key=lambda item: (
                source_order.get(item, 0),
                item,
            ),
        ):
            counts[dependent_id] -= 1

            if counts[dependent_id] == 0:
                ready.append(dependent_id)
                ready.sort(
                    key=lambda item: (
                        source_order.get(item, 0),
                        item,
                    )
                )

    return ordered


def _is_valid_terminal_execution_state(
    context: ValidationContext,
) -> bool:
    """
    Confirm that empty/NONE next-deliverable values represent the real
    end of the dependency graph rather than missing project data.
    """

    try:
        dependency_path = context.resolve_project_control_file(
            "CIPS_DEPENDENCY_MAP.yaml"
        )
        current_state_path = context.resolve_project_control_file(
            "CIPS_CURRENT_STATE.yaml"
        )

        dependency_document = load_document(
            context,
            dependency_path,
        )
        current_state_document = load_document(
            context,
            current_state_path,
        )
    except Exception:
        return False

    if not isinstance(dependency_document, Mapping):
        return False

    if not isinstance(current_state_document, Mapping):
        return False

    graph_state = dependency_document.get(
        "current_graph_state",
        {},
    )
    deliverables = dependency_document.get(
        "deliverables",
        {},
    )
    execution = current_state_document.get(
        "execution",
        {},
    )

    if not isinstance(graph_state, Mapping):
        return False

    if not isinstance(deliverables, Mapping):
        return False

    if not isinstance(execution, Mapping):
        return False

    current_deliverable = str(
        graph_state.get(
            "current_deliverable",
            "",
        )
    ).strip()

    dependency_next = graph_state.get(
        "next_deliverable",
        "",
    )

    current_record = execution.get(
        "current_deliverable",
        {},
    )
    next_record = execution.get(
        "next_deliverable",
        {},
    )

    if not isinstance(current_record, Mapping):
        return False

    if not isinstance(next_record, Mapping):
        return False

    current_state_deliverable = str(
        current_record.get(
            "id",
            "",
        )
    ).strip()

    current_state_next = next_record.get(
        "id",
        "",
    )

    if not current_deliverable:
        return False

    if current_state_deliverable != current_deliverable:
        return False

    if not _terminal_value(dependency_next):
        return False

    if not _terminal_value(current_state_next):
        return False

    ordered = _dependency_topological_order(
        deliverables
    )

    return bool(
        ordered
        and ordered[-1] == current_deliverable
    )


_original_validate_project_control_part_viii = (
    validate_project_control
)


def validate_project_control(
    context: ValidationContext,
) -> StageResult:
    """
    Run normal Project Control validation and normalize legitimate
    end-of-graph findings into an accepted terminal state.
    """

    result = _original_validate_project_control_part_viii(
        context
    )

    if not _is_valid_terminal_execution_state(
        context
    ):
        return result

    terminal_codes = {
        "PCV-CTL-DEPENDENCY-STATE-MISSING",
        "PCV-CTL-DELIVERABLE-ID-MISSING",
        "PCV-CTL-MANIFEST-STATUS-MISSING",
        "PCV-CTL-DELIVERABLE-NOT-IN-GRAPH",
        "PCV-CTL-NEXT-NOT-ORDERED",
        "PCV-CTL-PREVIOUS-ORDER",
    }

    retained_findings = []

    for finding in result.findings:
        message = str(
            getattr(
                finding,
                "message",
                "",
            )
        ).lower()
        code = str(
            getattr(
                finding,
                "code",
                "",
            )
        )

        remove = code in terminal_codes

        if (
            code == "PCV-CTL-EXECUTION-MISMATCH"
            and "next_deliverable" in message
        ):
            remove = True

        if not remove:
            retained_findings.append(finding)

    result.findings[:] = retained_findings

    result.add_finding(
        info_finding(
            code="PCV-CTL-END-OF-GRAPH-VALID",
            message=(
                "Current deliverable is the final dependency-graph node; "
                "the absence of a subsequent deliverable is valid."
            ),
            stage=StageName.PROJECT_CONTROL,
            source=context.resolve_project_control_file(
                "CIPS_DEPENDENCY_MAP.yaml"
            ),
        )
    )

    context.metadata["project_control_validated"] = (
        result.passed
    )

    return result


