# DEPENDENCY GRAPH SUPPORT
# =============================================================================

@dataclass(frozen=True, slots=True)
class DependencyNode:
    """Normalized node belonging to a directed dependency graph."""

    node_id: str
    dependencies: tuple[str, ...]
    source_section: str
    status: str | None = None
    name: str | None = None


def normalize_dependency_references(value: Any) -> tuple[str, ...]:
    """Normalize a dependency declaration into an immutable string tuple."""

    references = ensure_string_list(value)

    return tuple(
        reference.strip()
        for reference in references
        if reference.strip()
    )


def collect_dependency_nodes(
    dependency_map: Mapping[str, Any],
    section_names: Sequence[str],
) -> dict[str, DependencyNode]:
    """Collect normalized dependency nodes from selected YAML sections."""

    nodes: dict[str, DependencyNode] = {}

    for section_name in section_names:
        raw_section = dependency_map.get(section_name, {})

        if not isinstance(raw_section, Mapping):
            continue

        for raw_node_id, raw_record in raw_section.items():
            node_id = str(raw_node_id).strip()

            if not node_id or not isinstance(raw_record, Mapping):
                continue

            raw_dependencies = raw_record.get("dependencies", [])

            nodes[node_id] = DependencyNode(
                node_id=node_id,
                dependencies=normalize_dependency_references(
                    raw_dependencies
                ),
                source_section=section_name,
                status=(
                    normalize_state(raw_record.get("status"))
                    if raw_record.get("status") is not None
                    else None
                ),
                name=(
                    str(raw_record.get("name")).strip()
                    if raw_record.get("name") is not None
                    else None
                ),
            )

    return nodes


def merge_dependency_nodes(
    *node_groups: Mapping[str, DependencyNode],
) -> tuple[
    dict[str, DependencyNode],
    dict[str, list[str]],
]:
    """
    Merge graph node groups.

    Returns:
        A tuple containing the merged nodes and duplicate source sections.
    """

    merged: dict[str, DependencyNode] = {}
    duplicates: dict[str, list[str]] = {}

    for group in node_groups:
        for node_id, node in group.items():
            if node_id in merged:
                duplicates.setdefault(
                    node_id,
                    [merged[node_id].source_section],
                ).append(node.source_section)
                continue

            merged[node_id] = node

    return merged, duplicates


def detect_self_dependencies(
    nodes: Mapping[str, DependencyNode],
) -> list[str]:
    """Return node identifiers that depend directly on themselves."""

    return sorted(
        node_id
        for node_id, node in nodes.items()
        if node_id in node.dependencies
    )


def find_missing_dependency_references(
    nodes: Mapping[str, DependencyNode],
    *,
    externally_allowed: Iterable[str] = (),
) -> dict[str, list[str]]:
    """Return missing dependency references grouped by consumer node."""

    allowed = set(externally_allowed)
    known_nodes = set(nodes)
    missing: dict[str, list[str]] = {}

    for node_id, node in nodes.items():
        unresolved = sorted(
            dependency
            for dependency in node.dependencies
            if dependency not in known_nodes
            and dependency not in allowed
        )

        if unresolved:
            missing[node_id] = unresolved

    return missing


def detect_dependency_cycles(
    nodes: Mapping[str, DependencyNode],
) -> list[list[str]]:
    """Detect directed cycles using depth-first traversal."""

    visiting: set[str] = set()
    visited: set[str] = set()
    stack: list[str] = []
    stack_positions: dict[str, int] = {}
    cycles: list[list[str]] = []
    normalized_cycles: set[tuple[str, ...]] = set()

    def canonicalize_cycle(
        cycle: Sequence[str],
    ) -> tuple[str, ...]:
        """
        Return a rotation-independent representation of a closed cycle.

        The repeated final node is removed before canonicalization.
        """

        body = list(cycle[:-1])

        if not body:
            return ()

        rotations = [
            tuple(body[index:] + body[:index])
            for index in range(len(body))
        ]

        return min(rotations)

    def visit(node_id: str) -> None:
        if node_id in visited:
            return

        if node_id in visiting:
            return

        visiting.add(node_id)
        stack_positions[node_id] = len(stack)
        stack.append(node_id)

        node = nodes[node_id]

        for dependency in node.dependencies:
            if dependency not in nodes:
                continue

            if dependency in visiting:
                cycle_start = stack_positions[dependency]
                detected_cycle = (
                    stack[cycle_start:]
                    + [dependency]
                )
                canonical = canonicalize_cycle(detected_cycle)

                if canonical and canonical not in normalized_cycles:
                    normalized_cycles.add(canonical)
                    cycles.append(detected_cycle)

                continue

            if dependency not in visited:
                visit(dependency)

        stack.pop()
        stack_positions.pop(node_id, None)
        visiting.remove(node_id)
        visited.add(node_id)

    for candidate in sorted(nodes):
        if candidate not in visited:
            visit(candidate)

    return cycles


def topological_sort_nodes(
    nodes: Mapping[str, DependencyNode],
) -> list[str]:
    """
    Return a dependency-first topological order.

    Raises:
        ValidationExecutionError: When the graph contains a cycle.
    """

    dependency_count: dict[str, int] = {
        node_id: sum(
            dependency in nodes
            for dependency in node.dependencies
        )
        for node_id, node in nodes.items()
    }

    dependents: dict[str, set[str]] = {
        node_id: set()
        for node_id in nodes
    }

    for node_id, node in nodes.items():
        for dependency in node.dependencies:
            if dependency in nodes:
                dependents[dependency].add(node_id)

    ready = sorted(
        node_id
        for node_id, count in dependency_count.items()
        if count == 0
    )

    ordered: list[str] = []

    while ready:
        current = ready.pop(0)
        ordered.append(current)

        for dependent in sorted(dependents[current]):
            dependency_count[dependent] -= 1

            if dependency_count[dependent] == 0:
                ready.append(dependent)
                ready.sort()

    if len(ordered) != len(nodes):
        unresolved = sorted(
            node_id
            for node_id in nodes
            if node_id not in ordered
        )

        raise ValidationExecutionError(
            "Dependency graph cannot be topologically sorted. "
            f"Unresolved nodes: {', '.join(unresolved)}."
        )

    return ordered


def validate_dependency_node_statuses(
    *,
    nodes: Mapping[str, DependencyNode],
    valid_states: frozenset[str],
    stage: StageName,
    source: Path,
    code_prefix: str,
) -> list[ValidationFinding]:
    """Validate optional status fields belonging to dependency nodes."""

    findings: list[ValidationFinding] = []

    for node_id, node in nodes.items():
        if node.status is None:
            continue

        if node.status in valid_states:
            continue

        findings.append(
            error_finding(
                code=f"{code_prefix}-INVALID-STATUS",
                message=(
                    f"Dependency node {node_id!r} uses unsupported "
                    f"status {node.status!r}."
                ),
                stage=stage,
                source=source,
                remediation=(
                    "Replace the status with one of the official "
                    "Project Control states."
                ),
            )
        )

    return findings


def validate_dependency_graph_group(
    *,
    result: StageResult,
    nodes: Mapping[str, DependencyNode],
    graph_name: str,
    source: Path,
    valid_states: frozenset[str],
    externally_allowed: Iterable[str] = (),
) -> list[str]:
    """
    Validate one dependency graph and return its topological order.

    The supplied StageResult is updated with all findings.
    """

    if not nodes:
        result.checks_executed += 1
        result.add_finding(
            error_finding(
                code="PCV-DEP-GRAPH-EMPTY",
                message=f"Dependency graph {graph_name!r} contains no nodes.",
                stage=StageName.DEPENDENCIES,
                source=source,
                remediation=(
                    "Register the nodes required by the official Roadmap."
                ),
            )
        )
        return []

    result.checks_executed += 1
    self_dependencies = detect_self_dependencies(nodes)

    for node_id in self_dependencies:
        result.add_finding(
            critical_finding(
                code="PCV-DEP-SELF-REFERENCE",
                message=(
                    f"Node {node_id!r} in graph {graph_name!r} "
                    "depends on itself."
                ),
                stage=StageName.DEPENDENCIES,
                source=source,
                remediation=(
                    "Remove the self-reference from the dependency list."
                ),
            )
        )

    result.checks_executed += 1
    missing_references = find_missing_dependency_references(
        nodes,
        externally_allowed=externally_allowed,
    )

    for node_id, missing in missing_references.items():
        result.add_finding(
            error_finding(
                code="PCV-DEP-MISSING-REFERENCE",
                message=(
                    f"Node {node_id!r} in graph {graph_name!r} "
                    "references unknown dependencies: "
                    f"{', '.join(missing)}."
                ),
                stage=StageName.DEPENDENCIES,
                source=source,
                remediation=(
                    "Register each dependency or correct the invalid "
                    "reference."
                ),
            )
        )

    result.checks_executed += 1
    cycles = detect_dependency_cycles(nodes)

    for cycle in cycles:
        result.add_finding(
            critical_finding(
                code="PCV-DEP-CYCLE-DETECTED",
                message=(
                    f"Cycle detected in graph {graph_name!r}: "
                    f"{' -> '.join(cycle)}."
                ),
                stage=StageName.DEPENDENCIES,
                source=source,
                remediation=(
                    "Remove or redirect one dependency so the graph "
                    "remains acyclic."
                ),
            )
        )

    result.checks_executed += len(nodes)
    result.add_findings(
        validate_dependency_node_statuses(
            nodes=nodes,
            valid_states=valid_states,
            stage=StageName.DEPENDENCIES,
            source=source,
            code_prefix="PCV-DEP",
        )
    )

    if self_dependencies or missing_references or cycles:
        return []

    result.checks_executed += 1

    try:
        ordered = topological_sort_nodes(nodes)
    except ValidationExecutionError as exc:
        result.add_finding(
            critical_finding(
                code="PCV-DEP-TOPOLOGICAL-SORT-FAILED",
                message=str(exc),
                stage=StageName.DEPENDENCIES,
                source=source,
                remediation=(
                    "Correct dependency cycles and invalid references."
                ),
            )
        )
        return []

    result.add_finding(
        info_finding(
            code="PCV-DEP-GRAPH-VALID",
            message=(
                f"Dependency graph {graph_name!r} contains "
                f"{len(nodes)} nodes and supports deterministic "
                "topological ordering."
            ),
            stage=StageName.DEPENDENCIES,
            source=source,
        )
    )

    return ordered


