def read_text_file(path: Path) -> str:
    """Read a UTF-8 text file with controlled error handling."""

    try:
        return path.read_text(encoding=DEFAULT_ENCODING)
    except FileNotFoundError as exc:
        raise DocumentLoadError(
            f"Required file does not exist: {path}"
        ) from exc
    except UnicodeDecodeError as exc:
        raise DocumentLoadError(
            f"File is not valid UTF-8: {path}"
        ) from exc
    except OSError as exc:
        raise DocumentLoadError(
            f"Unable to read file {path}: {exc}"
        ) from exc


def load_json_document(path: Path) -> Any:
    """Load JSON while rejecting duplicate object keys."""

    def reject_duplicate_keys(
        pairs: list[tuple[str, Any]],
    ) -> dict[str, Any]:
        result: dict[str, Any] = {}

        for key, value in pairs:
            if key in result:
                raise DocumentLoadError(
                    f"Duplicate JSON key {key!r} in {path}"
                )

            result[key] = value

        return result

    text = read_text_file(path)

    try:
        return json.loads(
            text,
            object_pairs_hook=reject_duplicate_keys,
        )
    except json.JSONDecodeError as exc:
        raise DocumentLoadError(
            f"Invalid JSON document {path}: "
            f"line {exc.lineno}, column {exc.colno}: {exc.msg}"
        ) from exc


def load_toml_document(path: Path) -> Any:
    """Load a TOML document using the standard library."""

    try:
        import tomllib
    except ImportError as exc:  # pragma: no cover - Python < 3.11
        raise ConfigurationError(
            "TOML validation requires Python 3.11 or newer."
        ) from exc

    try:
        with path.open("rb") as file_handle:
            return tomllib.load(file_handle)
    except FileNotFoundError as exc:
        raise DocumentLoadError(
            f"Required file does not exist: {path}"
        ) from exc
    except tomllib.TOMLDecodeError as exc:
        raise DocumentLoadError(
            f"Invalid TOML document {path}: {exc}"
        ) from exc
    except OSError as exc:
        raise DocumentLoadError(
            f"Unable to read TOML file {path}: {exc}"
        ) from exc


def load_yaml_document(path: Path) -> Any:
    """Load YAML safely and reject duplicate mapping keys."""

    try:
        import yaml
    except ImportError as exc:
        raise ConfigurationError(
            "PyYAML is required. Install it with: "
            "python -m pip install PyYAML"
        ) from exc

    class UniqueKeySafeLoader(yaml.SafeLoader):
        """Safe YAML loader that rejects duplicate mapping keys."""

    def construct_unique_mapping(
        loader: Any,
        node: Any,
        deep: bool = False,
    ) -> dict[Any, Any]:
        loader.flatten_mapping(node)
        mapping: dict[Any, Any] = {}

        for key_node, value_node in node.value:
            key = loader.construct_object(
                key_node,
                deep=deep,
            )

            try:
                duplicate = key in mapping
            except TypeError as exc:
                raise DocumentLoadError(
                    f"Unhashable YAML mapping key in {path}: {key!r}"
                ) from exc

            if duplicate:
                mark = getattr(key_node, "start_mark", None)
                location = ""

                if mark is not None:
                    location = (
                        f" at line {mark.line + 1}, "
                        f"column {mark.column + 1}"
                    )

                raise DocumentLoadError(
                    f"Duplicate YAML key {key!r} in {path}{location}"
                )

            value = loader.construct_object(
                value_node,
                deep=deep,
            )
            mapping[key] = value

        return mapping

    UniqueKeySafeLoader.add_constructor(
        yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
        construct_unique_mapping,
    )

    text = read_text_file(path)

    try:
        return yaml.load(
            text,
            Loader=UniqueKeySafeLoader,
        )
    except DocumentLoadError:
        raise
    except yaml.YAMLError as exc:
        problem_mark = getattr(exc, "problem_mark", None)
        location = ""

        if problem_mark is not None:
            location = (
                f" at line {problem_mark.line + 1}, "
                f"column {problem_mark.column + 1}"
            )

        raise DocumentLoadError(
            f"Invalid YAML document {path}{location}: {exc}"
        ) from exc


def load_structured_document(path: Path) -> Any:
    """Load YAML, JSON or TOML based on the file extension."""

    suffix = path.suffix.lower()

    if suffix in {".yaml", ".yml"}:
        return load_yaml_document(path)

    if suffix == ".json":
        return load_json_document(path)

    if suffix == ".toml":
        return load_toml_document(path)

    raise DocumentLoadError(
        f"Unsupported structured document type: {path}"
    )


def load_document(
    context: ValidationContext,
    path: Path,
) -> Any:
    """Load and cache a project document."""

    cached = context.get_document(path)

    if cached is not None:
        return cached

    suffix = path.suffix.lower()

    if suffix in SUPPORTED_CONFIG_EXTENSIONS:
        document = load_structured_document(path)
    elif (
        suffix in SUPPORTED_DOCUMENT_EXTENSIONS
        or suffix in SUPPORTED_SOURCE_EXTENSIONS
    ):
        document = read_text_file(path)
    else:
        raise DocumentLoadError(
            f"Unsupported project document extension: {path}"
        )

    context.remember_document(path, document)
    return document


