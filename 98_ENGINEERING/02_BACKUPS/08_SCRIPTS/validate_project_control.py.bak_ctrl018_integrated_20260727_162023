def summarize_prior_stage_statuses(
    context: ValidationContext,
) -> dict[str, bool]:
    """Return stage validation flags stored in shared metadata."""

    return {
        "repository": bool(
            context.metadata.get("repository_validated")
        ),
        "contracts": bool(
            context.metadata.get("contracts_validated")
        ),
        "manifest": bool(
            context.metadata.get("manifest_validated")
        ),
        "dependencies": bool(
            context.metadata.get("dependencies_validated")
        ),
        "project_control": bool(
            context.metadata.get(
                "project_control_validated"
            )
        ),
        "baseline": bool(
            context.metadata.get("baseline_validated")
        ),
    }


def validate_certification(
    context: ValidationContext,
) -> StageResult:
    """Generate the final certification-stage result."""

    result = StageResult(stage=StageName.CERTIFICATION)
    stage_statuses = summarize_prior_stage_statuses(
        context
    )

    for stage_name, passed in stage_statuses.items():
        result.checks_executed += 1

        if passed:
            result.add_finding(
                info_finding(
                    code="PCV-CER-STAGE-PASS",
                    message=(
                        f"Required stage {stage_name!r} passed."
                    ),
                    stage=StageName.CERTIFICATION,
                )
            )
            continue

        result.add_finding(
            error_finding(
                code="PCV-CER-STAGE-FAILED",
                message=(
                    f"Required stage {stage_name!r} did not pass."
                ),
                stage=StageName.CERTIFICATION,
                remediation=(
                    "Correct all blocking findings in the failed stage "
                    "and rerun the complete validator."
                ),
            )
        )

    execution_state = context.metadata.get(
        "current_execution_state",
        {},
    )

    if isinstance(execution_state, Mapping):
        current_deliverable = str(
            execution_state.get(
                "current_deliverable",
                "",
            )
        ).strip()

        result.checks_executed += 1

        if current_deliverable != DELIVERABLE_ID:
            result.add_finding(
                warning_finding(
                    code="PCV-CER-ACTIVE-DELIVERABLE",
                    message=(
                        f"Current active deliverable is "
                        f"{current_deliverable!r}; validator "
                        f"certification deliverable is "
                        f"{DELIVERABLE_ID!r}."
                    ),
                    stage=StageName.CERTIFICATION,
                    remediation=(
                        "Confirm whether Current State is intentionally "
                        "being updated only at a significant checkpoint."
                    ),
                )
            )

    result.checks_executed += 1

    if all(stage_statuses.values()):
        result.add_finding(
            info_finding(
                code="PCV-CER-READY",
                message=(
                    "Project Control validation completed without "
                    "blocking structural findings."
                ),
                stage=StageName.CERTIFICATION,
            )
        )
    else:
        result.add_finding(
            error_finding(
                code="PCV-CER-NOT-READY",
                message=(
                    "Project Control cannot be certified because one "
                    "or more required validation stages failed."
                ),
                stage=StageName.CERTIFICATION,
                remediation=(
                    "Review the complete report and correct every "
                    "ERROR or CRITICAL finding."
                ),
            )
        )

    context.metadata["certification_validated"] = (
        result.passed
    )

    return result


