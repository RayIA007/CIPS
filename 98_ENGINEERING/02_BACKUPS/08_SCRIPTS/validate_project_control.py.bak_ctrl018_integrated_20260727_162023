def nested_get(
    data: Mapping[str, Any],
    path: Sequence[str],
    default: Any | None = None,
) -> Any:
    """Read a nested mapping value without raising KeyError."""

    current: Any = data

    for key in path:
        if not isinstance(current, Mapping):
            return default

        if key not in current:
            return default

        current = current[key]

    return current


def normalize_state(value: Any) -> str:
    """Normalize a state value for deterministic comparison."""

    return str(value).strip().upper().replace(" ", "_")


def normalize_relative_path(value: str | Path) -> str:
    """Normalize a repository-relative path to POSIX form."""

    return Path(value).as_posix().lstrip("./")


def ensure_string_list(value: Any) -> list[str]:
    """Normalize a scalar or sequence into a list of strings."""

    if value is None:
        return []

    if isinstance(value, str):
        return [value]

    if isinstance(value, Sequence):
        return [
            str(item)
            for item in value
            if item is not None
        ]

    return [str(value)]


