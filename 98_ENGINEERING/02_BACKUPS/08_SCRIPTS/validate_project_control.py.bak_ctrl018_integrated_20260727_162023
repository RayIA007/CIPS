def validate_manifest(
    context: ValidationContext,
) -> StageResult:
    """Validate the official repository inventory."""

    result = StageResult(stage=StageName.MANIFEST)
    manifest_path = context.resolve_project_control_file(
        "CIPS_FILE_MANIFEST.yaml"
    )

    try:
        raw_manifest = load_document(
            context,
            manifest_path,
        )
    except ProjectControlValidatorError as exc:
        result.checks_executed += 1
        result.add_finding(
            critical_finding(
                code="PCV-MAN-LOAD-FAILED",
                message=str(exc),
                stage=StageName.MANIFEST,
                source=manifest_path,
                remediation=(
                    "Correct the File Manifest before continuing."
                ),
            )
        )
        return result

    result.checks_executed += 1

    if not isinstance(raw_manifest, Mapping):
        result.add_finding(
            critical_finding(
                code="PCV-MAN-ROOT-TYPE",
                message="File Manifest root must be a mapping.",
                stage=StageName.MANIFEST,
                source=manifest_path,
            )
        )
        return result

    entries = collect_manifest_entries(raw_manifest)
    result.checks_executed += 1

    if not entries:
        result.add_finding(
            critical_finding(
                code="PCV-MAN-NO-ENTRIES",
                message="File Manifest contains no registered file entries.",
                stage=StageName.MANIFEST,
                source=manifest_path,
                remediation=(
                    "Register the constitutional and Project Control "
                    "files in the official manifest."
                ),
            )
        )
        return result

    file_id_pattern_prefix = "FILE-"
    seen_paths: dict[str, str] = {}
    seen_filenames: dict[str, list[str]] = {}
    valid_entries = 0

    required_record_keys = (
        "filename",
        "relative_path",
        "extension",
        "type",
        "subsystem",
        "owner",
        "lifecycle",
        "status",
        "phase",
        "version",
    )

    for file_id, record in entries.items():
        result.checks_executed += 1

        if not file_id.startswith(file_id_pattern_prefix):
            result.add_finding(
                error_finding(
                    code="PCV-MAN-ID-FORMAT",
                    message=(
                        f"Manifest identifier {file_id!r} does not follow "
                        "the FILE-XXXXX format."
                    ),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                    remediation=(
                        "Assign an immutable FILE-XXXXX identifier."
                    ),
                )
            )

        result.checks_executed += len(required_record_keys)
        missing_keys = [
            key
            for key in required_record_keys
            if key not in record
        ]

        if missing_keys:
            result.add_finding(
                error_finding(
                    code="PCV-MAN-RECORD-INCOMPLETE",
                    message=(
                        f"Manifest entry {file_id!r} is missing required "
                        f"fields: {', '.join(missing_keys)}."
                    ),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                    remediation=(
                        "Complete the entry according to the official "
                        "file registration model."
                    ),
                )
            )
            continue

        filename = str(record["filename"]).strip()
        raw_relative_path = str(record["relative_path"]).strip()
        relative_path = normalize_relative_path(raw_relative_path)
        extension = str(record["extension"]).strip().lower().lstrip(".")
        status = normalize_state(record["status"])
        lifecycle = normalize_state(record["lifecycle"])

        result.checks_executed += 1

        if not filename:
            result.add_finding(
                error_finding(
                    code="PCV-MAN-FILENAME-EMPTY",
                    message=f"Manifest entry {file_id!r} has no filename.",
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                )
            )

        result.checks_executed += 1

        if not relative_path:
            result.add_finding(
                error_finding(
                    code="PCV-MAN-PATH-EMPTY",
                    message=(
                        f"Manifest entry {file_id!r} has no relative path."
                    ),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                )
            )
            continue

        result.checks_executed += 1

        if Path(relative_path).name != filename:
            result.add_finding(
                error_finding(
                    code="PCV-MAN-FILENAME-PATH-MISMATCH",
                    message=(
                        f"Filename {filename!r} does not match the final "
                        f"component of path {relative_path!r}."
                    ),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                    remediation=(
                        "Correct either filename or relative_path so "
                        "both identify the same repository file."
                    ),
                )
            )

        result.checks_executed += 1

        path_extension = Path(filename).suffix.lower().lstrip(".")

        if path_extension != extension:
            result.add_finding(
                error_finding(
                    code="PCV-MAN-EXTENSION-MISMATCH",
                    message=(
                        f"Entry {file_id!r} declares extension "
                        f"{extension!r}, but filename uses "
                        f"{path_extension!r}."
                    ),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                )
            )

        result.checks_executed += 1

        if relative_path in seen_paths:
            result.add_finding(
                critical_finding(
                    code="PCV-MAN-DUPLICATE-PATH",
                    message=(
                        f"Entries {seen_paths[relative_path]!r} and "
                        f"{file_id!r} register the same path "
                        f"{relative_path!r}."
                    ),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                    remediation=(
                        "Maintain exactly one manifest identity per "
                        "repository path."
                    ),
                )
            )
        else:
            seen_paths[relative_path] = file_id

        seen_filenames.setdefault(filename, []).append(file_id)

        result.checks_executed += 1

        if status not in VALID_DELIVERABLE_STATES:
            result.add_finding(
                error_finding(
                    code="PCV-MAN-INVALID-STATUS",
                    message=(
                        f"Entry {file_id!r} uses unsupported status "
                        f"{status!r}."
                    ),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                    remediation=(
                        "Use one of the official deliverable states."
                    ),
                )
            )

        result.checks_executed += 1

        if lifecycle not in VALID_DELIVERABLE_STATES:
            result.add_finding(
                error_finding(
                    code="PCV-MAN-INVALID-LIFECYCLE",
                    message=(
                        f"Entry {file_id!r} uses unsupported lifecycle "
                        f"{lifecycle!r}."
                    ),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                )
            )

        try:
            resolved_path = resolve_manifest_path(
                context,
                relative_path,
            )
        except DocumentLoadError as exc:
            result.add_finding(
                critical_finding(
                    code="PCV-MAN-PATH-ESCAPE",
                    message=str(exc),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                )
            )
            continue

        result.checks_executed += 1

        if state_means_file_should_exist(status):
            if not resolved_path.is_file():
                result.add_finding(
                    error_finding(
                        code="PCV-MAN-REGISTERED-FILE-MISSING",
                        message=(
                            f"Manifest entry {file_id!r} requires a "
                            f"physical file, but it is missing: "
                            f"{relative_path}"
                        ),
                        stage=StageName.MANIFEST,
                        source=resolved_path,
                        remediation=(
                            "Restore the registered file or correct its "
                            "manifest state."
                        ),
                    )
                )
            else:
                result.add_finding(
                    info_finding(
                        code="PCV-MAN-REGISTERED-FILE-PRESENT",
                        message=(
                            f"Registered file {file_id!r} exists at its "
                            "declared path."
                        ),
                        stage=StageName.MANIFEST,
                        source=resolved_path,
                    )
                )

        valid_entries += 1

    expected_manifest_files = (
        *CONSTITUTIONAL_FILES,
        *PROJECT_CONTROL_FILES,
    )

    for expected_filename in expected_manifest_files:
        result.checks_executed += 1
        located = find_manifest_entry_by_filename(
            entries,
            expected_filename,
        )

        if located is None:
            result.add_finding(
                error_finding(
                    code="PCV-MAN-REQUIRED-ENTRY-MISSING",
                    message=(
                        f"Required repository file "
                        f"{expected_filename!r} is not registered."
                    ),
                    stage=StageName.MANIFEST,
                    source=manifest_path,
                    remediation=(
                        "Add the missing file to the official File "
                        "Manifest."
                    ),
                )
            )

    result.checks_executed += 1
    validator_entry = find_manifest_entry_by_filename(
        entries,
        "validate_project_control.py",
    )

    if validator_entry is None:
        result.add_finding(
            error_finding(
                code="PCV-MAN-VALIDATOR-NOT-REGISTERED",
                message=(
                    "validate_project_control.py is not registered in "
                    "the File Manifest."
                ),
                stage=StageName.MANIFEST,
                source=manifest_path,
                remediation=(
                    "Register CTRL-015 using its approved repository path."
                ),
            )
        )
    else:
        validator_file_id, validator_record = validator_entry
        declared_path = normalize_relative_path(
            str(validator_record.get("relative_path", ""))
        )
        actual_path = repository_relative_path(
            context,
            SCRIPT_PATH,
        )

        result.checks_executed += 1

        if declared_path != actual_path:
            result.add_finding(
                error_finding(
                    code="PCV-MAN-VALIDATOR-PATH-MISMATCH",
                    message=(
                        f"Manifest entry {validator_file_id!r} declares "
                        f"{declared_path!r}, but the validator is running "
                        f"from {actual_path!r}."
                    ),
                    stage=StageName.MANIFEST,
                    source=SCRIPT_PATH,
                    remediation=(
                        "Align the File Manifest with the approved "
                        "12_PRODUCTION_SYSTEM/08_SCRIPTS location."
                    ),
                )
            )

    declared_summary = raw_manifest.get("manifest_summary")

    if isinstance(declared_summary, Mapping):
        declared_total = declared_summary.get(
            "total_registered_entries"
        )

        result.checks_executed += 1

        if declared_total is not None:
            try:
                normalized_total = int(declared_total)
            except (TypeError, ValueError):
                result.add_finding(
                    error_finding(
                        code="PCV-MAN-SUMMARY-TOTAL-TYPE",
                        message=(
                            "manifest_summary.total_registered_entries "
                            "must be an integer."
                        ),
                        stage=StageName.MANIFEST,
                        source=manifest_path,
                    )
                )
            else:
                if normalized_total != len(entries):
                    result.add_finding(
                        error_finding(
                            code="PCV-MAN-SUMMARY-TOTAL-MISMATCH",
                            message=(
                                "Manifest summary total does not match "
                                "the number of registered entries."
                            ),
                            stage=StageName.MANIFEST,
                            source=manifest_path,
                            remediation=(
                                f"Set total_registered_entries to "
                                f"{len(entries)}."
                            ),
                        )
                    )

    context.metadata["manifest_entries"] = entries
    context.metadata["manifest_entry_count"] = len(entries)
    context.metadata["manifest_valid_entries"] = valid_entries
    context.metadata["manifest_validated"] = result.passed

    if result.passed:
        result.add_finding(
            info_finding(
                code="PCV-MAN-VALID",
                message=(
                    f"File Manifest contains {len(entries)} registered "
                    "entries and passed structural validation."
                ),
                stage=StageName.MANIFEST,
                source=manifest_path,
            )
        )

    return result


