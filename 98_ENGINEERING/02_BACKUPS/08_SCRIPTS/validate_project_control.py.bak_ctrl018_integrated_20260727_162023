_previous_validate_dependencies_ctrl016_terminal = validate_dependencies


def validate_dependencies(
    context: ValidationContext,
) -> StageResult:
    """
    Remove the legacy unknown-deliverable error for the explicit NONE
    sentinel only when the current deliverable is verified as the final
    dependency-graph node.
    """

    result = _previous_validate_dependencies_ctrl016_terminal(
        context
    )

    if not _is_valid_terminal_execution_state(
        context
    ):
        return result

    retained = []

    for finding in result.findings:
        code = str(
            getattr(
                finding,
                "code",
                "",
            )
        )
        message = str(
            getattr(
                finding,
                "message",
                "",
            )
        ).lower()

        remove = (
            code == "PCV-DEP-CURRENT-STATE-REFERENCE"
            and "next_deliverable" in message
            and "none" in message
        )

        if not remove:
            retained.append(finding)

    result.findings[:] = retained
    context.metadata["dependencies_validated"] = (
        result.passed
    )

    return result


