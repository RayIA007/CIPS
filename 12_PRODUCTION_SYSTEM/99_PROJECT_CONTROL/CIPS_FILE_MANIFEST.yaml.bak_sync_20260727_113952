# =============================================================================
#
# CIPS FILE MANIFEST
#
# Official Repository Inventory
#
# =============================================================================

document:

  name: CIPS_FILE_MANIFEST.yaml

  official_name: Official Repository Inventory

  version: 2.0.0

  status: ACTIVE

  type: PROJECT_CONTROL

  authority: Production Architecture Board

# =============================================================================
# PROJECT
# =============================================================================

project:

  name: ConsejoIA_V5

  codename: CIPS Production Operating System

  target_version: 1.0.0

# =============================================================================
# PURPOSE
# =============================================================================

purpose:

  description: >
    Define the official inventory of every architectural artifact belonging
    to the Production Operating System.

  objectives:

    - Maintain repository integrity

    - Provide a single source of truth for repository contents

    - Enable repository auditing

    - Support automated validation

    - Enable dependency discovery

    - Enable bootstrap automation

    - Support engineering intelligence

# =============================================================================
# INVENTORY PRINCIPLES
# =============================================================================

principles:

  single_source_of_truth: true

  repository_complete: true

  deterministic_structure: true

  explicit_file_registration: true

  immutable_identity: true

  traceable_lifecycle: true

  architecture_driven: true

# =============================================================================
# FILE STATES
# =============================================================================

file_states:

  RESERVED:

    description: >
      Planned by the architecture but not yet created.

  IMPLEMENTED:

    description: >
      File exists and is under development.

  ACCEPTED:

    description: >
      Officially accepted.

  DEPRECATED:

    description: >
      Scheduled for retirement.

  ARCHIVED:

    description: >
      Preserved for historical reasons.

# =============================================================================
# FILE TYPES
# =============================================================================

file_types:

  DOCUMENTATION:

    extensions:

      - md

  CONFIGURATION:

    extensions:

      - yaml

      - yml

      - json

      - toml

  SOURCE_CODE:

    extensions:

      - py

  TEST:

    extensions:

      - py

  TEMPLATE:

    extensions:

      - jinja2

      - txt

  DATA:

    extensions:

      - sqlite

      - db

      - csv

  ASSET:

    extensions:

      - png

      - jpg

      - svg

      - wav

      - mp4

# =============================================================================
# REPOSITORY ROOTS
# =============================================================================

repository_roots:

  constitutional_documents:

    description: >
      Technical Constitution.

  production_system:

    description: >
      Production Operating System.

  developer_tools:

    description: >
      Internal engineering ecosystem.

  runtime:

    description: >
      Runtime execution environment.

  tests:

    description: >
      Validation infrastructure.

# =============================================================================
# REGISTRATION RULES
# =============================================================================

registration_rules:

  every_file_must_be_registered: true

  duplicate_paths_forbidden: true

  duplicate_identifiers_forbidden: true

  unknown_files_forbidden: true

  orphan_files_forbidden: true

# =============================================================================
# END OF PART I
# =============================================================================
# =============================================================================
# FILE REGISTRATION MODEL
# =============================================================================

registration_model:

  identifier_format:

    pattern: FILE-XXXXX

    unique: true

    immutable: true

  path_policy:

    absolute_paths: forbidden

    relative_paths: required

    normalized_paths: required

  naming:

    case_sensitive: true

    duplicate_names_allowed: true

    duplicate_paths_allowed: false

# =============================================================================
# INVENTORY HIERARCHY
# =============================================================================

inventory_hierarchy:

  level_0:

    name: Repository

  level_1:

    name: Top Directory

  level_2:

    name: Module

  level_3:

    name: Component

  level_4:

    name: File

# =============================================================================
# FILE METADATA
# =============================================================================

file_metadata:

  required:

    - file_id

    - filename

    - relative_path

    - extension

    - type

    - subsystem

    - owner

    - lifecycle

    - status

    - phase

    - version

  optional:

    - description

    - dependencies

    - consumers

    - tags

    - protected

    - generated

    - checksum

# =============================================================================
# ARCHITECTURAL OWNERSHIP
# =============================================================================

ownership:

  constitutional_documents:

    owner: Technical Constitution

  project_control:

    owner: Project Control System

  engineering_knowledge:

    owner: Engineering Knowledge System

  developer_tools:

    owner: Developer Tool Suite

  production_os:

    owner: Production Operating System

# =============================================================================
# LIFECYCLE
# =============================================================================

lifecycle:

  RESERVED:

    next:

      - IMPLEMENTED

  IMPLEMENTED:

    next:

      - TESTED

      - DEPRECATED

  TESTED:

    next:

      - ACCEPTED

      - REJECTED

  ACCEPTED:

    next:

      - SUPERSEDED

      - DEPRECATED

  SUPERSEDED:

    next:

      - ARCHIVED

  DEPRECATED:

    next:

      - ARCHIVED

  ARCHIVED:

    next: []

# =============================================================================
# FILE CLASSIFICATION
# =============================================================================

classification:

  architecture:

    priority: CRITICAL

  contracts:

    priority: CRITICAL

  interfaces:

    priority: CRITICAL

  project_control:

    priority: HIGH

  developer_tools:

    priority: HIGH

  runtime:

    priority: HIGH

  providers:

    priority: HIGH

  implementation:

    priority: NORMAL

  tests:

    priority: NORMAL

  documentation:

    priority: NORMAL

  assets:

    priority: LOW

# =============================================================================
# INVENTORY VALIDATION
# =============================================================================

inventory_validation:

  required_checks:

    - identifier_uniqueness

    - path_uniqueness

    - valid_extension

    - valid_owner

    - valid_subsystem

    - valid_phase

    - valid_status

    - lifecycle_consistency

    - dependency_consistency

# =============================================================================
# SUBSYSTEM REGISTRATION
# =============================================================================

subsystems:

  constitutional_layer:

    inventory_required: true

  project_control:

    inventory_required: true

  engineering_knowledge:

    inventory_required: true

  developer_tools:

    inventory_required: true

  production_os:

    inventory_required: true

# =============================================================================
# INVENTORY INDEXES
# =============================================================================

indexes:

  by_identifier: true

  by_filename: true

  by_relative_path: true

  by_subsystem: true

  by_owner: true

  by_phase: true

  by_type: true

  by_status: true

